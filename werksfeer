#!/usr/bin/env bash
# shellcheck disable=SC2001 # sed expressions below use regular expressions intentionally.
# werksfeer - Universal git worktree setup tool
# https://github.com/DefactoSoftware/werksfeer
#
# Compatible with bash 3.2+ (macOS default), bash 5.x, and called from zsh/fish.
# Requires: git, optionally PostgreSQL tools for database cloning/services.

set -euo pipefail

WERKSFEER_VERSION="0.4.0"

WERKSFEER_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

log_info()  { echo "[werksfeer] $*" >&2; }
log_warn()  { echo "[werksfeer] WARNING: $*" >&2; }
log_error() { echo "[werksfeer] ERROR: $*" >&2; }
log_debug() { [ "${WERKSFEER_DEBUG:-0}" = "1" ] && echo "[werksfeer] DEBUG: $*" >&2 || true; }
log_step()  { echo "[werksfeer] ==> $*" >&2; }

load_werksfeer_modules() {
  local lib_dir="${WERKSFEER_LIB_DIR:-}"

  if [ -z "$lib_dir" ] && [ -f "${WERKSFEER_SCRIPT_DIR}/lib/werksfeer/services.sh" ]; then
    lib_dir="${WERKSFEER_SCRIPT_DIR}/lib/werksfeer"
  fi

  if [ -z "$lib_dir" ]; then
    lib_dir="${XDG_DATA_HOME:-$HOME/.local/share}/werksfeer/lib"
  fi

  if [ ! -f "${lib_dir}/services.sh" ] ||
      [ ! -f "${lib_dir}/services/postgres.sh" ] ||
      [ ! -f "${lib_dir}/cache.sh" ]; then
    log_error "Werksfeer modules were not found in $lib_dir"
    log_info "Reinstall werksfeer with install.sh or set WERKSFEER_LIB_DIR"
    return 1
  fi

  # shellcheck source=/dev/null
  source "${lib_dir}/services.sh"
  # shellcheck source=/dev/null
  source "${lib_dir}/services/postgres.sh"
  # shellcheck source=/dev/null
  source "${lib_dir}/cache.sh"
}

# ---------------------------------------------------------------------------
# Minimal TOML parser
# ---------------------------------------------------------------------------
# Handles [section], key = "value", key = ["a", "b"], key = true/false/int.
# Stores values in _TOML_<SECTION>_<KEY> variables.
# Arrays are stored as newline-delimited strings.

_TOML_PARSED=0

toml_parse() {
  local file="$1"
  [ ! -f "$file" ] && return 0
  _TOML_PARSED=1

  local section=""
  while IFS= read -r line || [ -n "$line" ]; do
    # Strip inline comments (only outside quotes — simplified: strip # not inside quotes)
    line="$(echo "$line" | sed 's/[[:space:]]*#[^"]*$//')"
    # Trim whitespace
    line="$(echo "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
    [ -z "$line" ] && continue

    # Section header
    if echo "$line" | grep -qE '^\[[a-zA-Z_][a-zA-Z0-9_]*\]$'; then
      section="$(echo "$line" | sed 's/^\[\(.*\)\]$/\1/' | tr '[:lower:]' '[:upper:]')"
      continue
    fi

    # Key = value
    local key value
    key="$(echo "$line" | sed 's/[[:space:]]*=.*//' | tr '[:lower:]' '[:upper:]' | sed 's/[^A-Z0-9_]/_/g')"
    value="$(echo "$line" | sed 's/^[^=]*=[[:space:]]*//')"

    [ -z "$key" ] && continue
    [ -z "$section" ] && section="DEFAULT"

    # Array value: ["a", "b", "c"]
    if echo "$value" | grep -qE '^\['; then
      # Strip brackets, quotes, split on comma
      value="$(echo "$value" | sed 's/^\[//;s/\]$//;s/"//g;s/'\''//g' | tr ',' '\n' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | grep -v '^$')"
    else
      # Strip surrounding quotes from scalar
      value="$(echo "$value" | sed 's/^"//;s/"$//;s/^'\''//;s/'\''$//')"
    fi

    local varname="_TOML_${section}_${key}"
    eval "${varname}=\$(cat <<'_TOML_EOF_'
${value}
_TOML_EOF_
)"
  done < "$file"
}

toml_get() {
  local section key default varname
  section="$(echo "$1" | tr '[:lower:]' '[:upper:]')"
  key="$(echo "$2" | tr '[:lower:]' '[:upper:]' | sed 's/[^A-Z0-9_]/_/g')"
  default="${3:-}"
  varname="_TOML_${section}_${key}"
  eval "echo \"\${${varname}:-${default}}\""
}

toml_get_array() {
  local section key varname
  section="$(echo "$1" | tr '[:lower:]' '[:upper:]')"
  key="$(echo "$2" | tr '[:lower:]' '[:upper:]' | sed 's/[^A-Z0-9_]/_/g')"
  varname="_TOML_${section}_${key}"
  eval "echo \"\${${varname}:-}\""
}

toml_reset() {
  local variable_name
  while IFS= read -r variable_name; do
    unset "$variable_name"
  done < <(compgen -A variable _TOML_)
  _TOML_PARSED=0
}

# ---------------------------------------------------------------------------
# Git helpers
# ---------------------------------------------------------------------------

is_git_repo() {
  git rev-parse --git-dir >/dev/null 2>&1
}

is_worktree() {
  # In a worktree .git is a FILE (contains "gitdir: ..."), not a directory
  [ -f ".git" ]
}

get_main_worktree_path() {
  git worktree list --porcelain | head -1 | sed 's/^worktree //'
}

get_worktree_name() {
  basename "$(pwd)"
}

get_worktree_branch() {
  git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "HEAD"
}

get_project_name() {
  basename "$(get_main_worktree_path)" | tr '[:upper:]' '[:lower:]'
}

sanitize_name() {
  echo "$1" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9_]/_/g' | sed 's/__*/_/g' | sed 's/^_//;s/_$//'
}

# ---------------------------------------------------------------------------
# Port / Redis allocation registry
# ---------------------------------------------------------------------------
# File: ~/.local/share/werksfeer/allocations
# Format: project_path<TAB>worktree_name<TAB>port<TAB>redis_db

allocations_file() {
  echo "${XDG_DATA_HOME:-$HOME/.local/share}/werksfeer/allocations"
}

# Find the next available port starting from base+1, skipping any already in the registry.
allocate_port() {
  local base_port="$1"
  local alloc
  alloc="$(allocations_file)"
  local port=$(( base_port + 1 ))

  while true; do
    if [ ! -f "$alloc" ] || ! awk -F'\t' '{print $3}' "$alloc" | grep -qxF "$port"; then
      echo "$port"
      return
    fi
    port=$(( port + 1 ))
  done
}

# Find the next available Redis DB (1-15) for a given project, skipping any in use.
allocate_redis_db() {
  local project="$1"
  local alloc
  alloc="$(allocations_file)"
  local db=1

  while [ "$db" -le 15 ]; do
    if [ ! -f "$alloc" ] || ! awk -F'\t' -v p="$project" '$1 == p {print $4}' "$alloc" | grep -qxF "$db"; then
      echo "$db"
      return
    fi
    db=$(( db + 1 ))
  done

  # All 15 slots taken — fall back to 1
  log_warn "All 15 Redis databases in use for this project, reusing DB 1"
  echo 1
}

# Find the next available Redis port starting from base+1, skipping any already in the registry.
allocate_redis_port() {
  local base_port="$1"
  local alloc
  alloc="$(allocations_file)"
  local port=$(( base_port + 1 ))

  while true; do
    if [ ! -f "$alloc" ] || ! awk -F'\t' '{print $5}' "$alloc" | grep -qxF "$port"; then
      echo "$port"
      return
    fi
    port=$(( port + 1 ))
  done
}

# One lock for the files under werksfeer/ that are read, changed and renamed
# (allocations and the database record). mkdir is atomic on Linux and macOS,
# which have no common flock. The owner's pid is stored in the lock; a lock whose
# owner is gone is stale and removed. A lock that cannot be taken within
# WERKSFEER_LOCK_TIMEOUT seconds (default 30) fails loudly: the caller must not
# go on unlocked. Taking it again in the same process only counts.
WERKSFEER_LOCK_DEPTH=0
WERKSFEER_LOCK_DIR=""

state_lock_acquire() {
  local dir ticks=0 limit owner

  if [ "$WERKSFEER_LOCK_DEPTH" -gt 0 ]; then
    WERKSFEER_LOCK_DEPTH=$(( WERKSFEER_LOCK_DEPTH + 1 ))
    return 0
  fi

  dir="$(dirname "$(allocations_file)")/state.lock"
  limit=$(( ${WERKSFEER_LOCK_TIMEOUT:-30} * 10 ))
  mkdir -p "$(dirname "$dir")"

  until mkdir "$dir" 2>/dev/null; do
    owner="$(cat "${dir}/pid" 2>/dev/null || true)"
    if [ -n "$owner" ] && ! kill -0 "$owner" 2>/dev/null; then
      log_warn "Removing stale werksfeer lock of process $owner"
      rm -f "${dir}/pid"
      rmdir "$dir" 2>/dev/null || true
      continue
    fi
    ticks=$(( ticks + 1 ))
    if [ "$ticks" -gt "$limit" ]; then
      log_error "Could not take the werksfeer lock $dir in ${WERKSFEER_LOCK_TIMEOUT:-30}s (held by process ${owner:-unknown}). If no werksfeer is running, remove that directory."
      return 1
    fi
    sleep 0.1
  done

  printf '%s\n' "$$" > "${dir}/pid"
  WERKSFEER_LOCK_DIR="$dir"
  WERKSFEER_LOCK_DEPTH=1
  trap 'state_lock_release_all' EXIT
}

state_lock_release() {
  [ "$WERKSFEER_LOCK_DEPTH" -gt 0 ] || return 0
  WERKSFEER_LOCK_DEPTH=$(( WERKSFEER_LOCK_DEPTH - 1 ))
  if [ "$WERKSFEER_LOCK_DEPTH" -eq 0 ]; then
    # Only a lock this process owns is removed.
    if [ "$(cat "${WERKSFEER_LOCK_DIR}/pid" 2>/dev/null || true)" = "$$" ]; then
      rm -f "${WERKSFEER_LOCK_DIR}/pid"
      rmdir "$WERKSFEER_LOCK_DIR" 2>/dev/null || true
    fi
  fi
}

# The EXIT trap: release only when this process still holds the lock.
state_lock_release_all() {
  [ "$WERKSFEER_LOCK_DEPTH" -gt 0 ] || return 0
  WERKSFEER_LOCK_DEPTH=1
  state_lock_release
}

# Register an allocation
register_allocation() {
  local project="$1"
  local wt_name="$2"
  local port="$3"
  local redis_db="$4"
  local redis_port="${5:-}"
  local alloc
  alloc="$(allocations_file)"

  mkdir -p "$(dirname "$alloc")"
  printf '%s\t%s\t%s\t%s\t%s\n' "$project" "$wt_name" "$port" "$redis_db" "$redis_port" >> "$alloc"
}

# Remove an allocation by worktree name (and optionally project)
deregister_allocation() {
  local wt_name="$1"
  local project="${2:-}"
  local alloc
  alloc="$(allocations_file)"
  [ ! -f "$alloc" ] && return 0

  state_lock_acquire || return 1
  local tmp="${alloc}.tmp"
  if [ -n "$project" ]; then
    awk -F'\t' -v p="$project" -v w="$wt_name" '!($1 == p && $2 == w)' "$alloc" > "$tmp"
  else
    awk -F'\t' -v w="$wt_name" '$2 != w' "$alloc" > "$tmp"
  fi
  mv "$tmp" "$alloc"
  state_lock_release
}

# Look up existing allocation for a worktree. Prints "port<TAB>redis_db<TAB>redis_port" or empty.
lookup_allocation() {
  local project="$1"
  local wt_name="$2"
  local alloc
  alloc="$(allocations_file)"
  [ ! -f "$alloc" ] && return 0

  awk -F'\t' -v p="$project" -v w="$wt_name" '$1 == p && $2 == w {printf "%s\t%s\t%s", $3, $4, $5}' "$alloc"
}

is_worktree_creation() {
  local prev_head="${1:-}"
  local new_head="${2:-}"
  local flag="${3:-}"
  local null_ref="0000000000000000000000000000000000000000"

  # Must be a branch checkout (flag=1), from the null ref, and .git is a file
  [ "$flag" = "1" ] && [ "$prev_head" = "$null_ref" ] && [ -f ".git" ]
}

# ---------------------------------------------------------------------------
# Project detection
# ---------------------------------------------------------------------------

detect_project_type() {
  local root="$1"

  if [ -f "$root/Gemfile" ] && [ -f "$root/config/database.yml" ]; then
    echo "rails"; return
  fi
  if [ -f "$root/mix.exs" ]; then
    echo "elixir"; return
  fi
  if [ -f "$root/pyproject.toml" ] || [ -f "$root/requirements.txt" ] || [ -f "$root/Pipfile" ]; then
    echo "python"; return
  fi
  if [ -f "$root/package.json" ]; then
    echo "node"; return
  fi
  echo "unknown"
}

load_project_configuration() {
  local project_root main_path project_config main_local_config worktree_local_config
  project_root="$(cd "$1" && pwd -P)"
  main_path="$(cd "$project_root" && get_main_worktree_path)"

  if [ -f "$project_root/.worktree.toml" ]; then
    project_config="$project_root/.worktree.toml"
  elif [ -f "$main_path/.worktree.toml" ]; then
    project_config="$main_path/.worktree.toml"
  else
    log_error "No .worktree.toml found for $project_root"
    return 1
  fi

  toml_parse "$project_config"

  # Personal settings in the main checkout apply to all of its linked
  # worktrees. A worktree-local file can override those settings one last time.
  # Repositories should ignore this file so credentials and preferences remain
  # local and do not make an otherwise reusable cache source appear dirty.
  main_local_config="$main_path/.worktree.local.toml"
  if [ -f "$main_local_config" ]; then
    toml_parse "$main_local_config"
    log_debug "Loaded local configuration from $main_local_config"
  fi

  worktree_local_config="$project_root/.worktree.local.toml"
  if [ "$worktree_local_config" != "$main_local_config" ] && [ -f "$worktree_local_config" ]; then
    toml_parse "$worktree_local_config"
    log_debug "Loaded worktree-local configuration from $worktree_local_config"
  fi
}

current_project_root() {
  git rev-parse --show-toplevel 2>/dev/null
}

# ---------------------------------------------------------------------------
# Default directories to symlink per project type (large, identical across worktrees)
# ---------------------------------------------------------------------------

default_symlink_dirs() {
  case "$1" in
    rails|elixir|node)
      printf '%s\n' node_modules
      ;;
    *)
      # Python, unknown: nothing to symlink by default
      ;;
  esac
}

# Default directories to copy per project type (build artifacts, caches)
# ---------------------------------------------------------------------------

default_copy_dirs() {
  case "$1" in
    rails)
      printf '%s\n' .bundle tmp/cache
      ;;
    elixir)
      printf '%s\n' _build deps priv/static
      ;;
    python)
      printf '%s\n' .venv __pycache__ .mypy_cache .pytest_cache .ruff_cache
      ;;
    node)
      printf '%s\n' .next .nuxt .svelte-kit .turbo .parcel-cache
      ;;
    *)
      ;;
  esac
}

default_copy_files() {
  case "$1" in
    rails)
      printf '%s\n' .env .sample.env .tool-versions
      ;;
    elixir)
      printf '%s\n' .envrc .tool-versions
      ;;
    python)
      printf '%s\n' .env .tool-versions .python-version
      ;;
    node)
      printf '%s\n' .env .nvmrc .node-version .tool-versions
      ;;
    *)
      printf '%s\n' .env
      ;;
  esac
}

# ---------------------------------------------------------------------------
# File sync
# ---------------------------------------------------------------------------

sync_env_files() {
  local main_path="$1"
  local worktree_path="$2"
  local project_type="$3"

  local copy_files
  copy_files="$(toml_get_array "sync" "copy")"
  [ -z "$copy_files" ] && copy_files="$(default_copy_files "$project_type")"

  echo "$copy_files" | while IFS= read -r file; do
    [ -z "$file" ] && continue
    local src="$main_path/$file"
    local dst="$worktree_path/$file"

    if [ ! -f "$src" ]; then
      log_debug "Skip copy $file (not in main worktree)"
      continue
    fi
    if [ -f "$dst" ]; then
      log_info "Skip copy $file (already exists)"
      continue
    fi

    local parent
    parent="$(dirname "$dst")"
    [ ! -d "$parent" ] && mkdir -p "$parent"

    cp "$src" "$dst"
    log_info "Copied $file"
  done
}

sync_symlink_dirs() {
  local main_path="$1"
  local worktree_path="$2"
  local project_type="$3"

  local symlink_dirs
  symlink_dirs="$(toml_get_array "sync" "symlink")"
  [ -z "$symlink_dirs" ] && symlink_dirs="$(default_symlink_dirs "$project_type")"
  [ -z "$symlink_dirs" ] && return 0

  if ! reusable_worktree_cache "$main_path" "$worktree_path"; then
    log_info "Skip shared directories (main checkout is not an exact, clean cache source)"
    return 0
  fi

  local skip_dirs
  skip_dirs="$(toml_get_array "sync" "skip")"

  echo "$symlink_dirs" | while IFS= read -r dir; do
    [ -z "$dir" ] && continue

    # Check skip list
    if [ -n "$skip_dirs" ] && echo "$skip_dirs" | grep -qxF "$dir"; then
      log_info "Skip symlink $dir (in skip list)"
      continue
    fi

    local src="$main_path/$dir"
    local dst="$worktree_path/$dir"

    if [ -L "$dst" ]; then
      log_info "Skip symlink $dir (already linked)"
      continue
    fi
    if [ -d "$dst" ]; then
      log_warn "$dir exists as directory, not symlinking"
      continue
    fi
    if [ ! -d "$src" ]; then
      log_debug "Skip symlink $dir (not yet in main worktree)"
      continue
    fi

    local parent
    parent="$(dirname "$dst")"
    [ ! -d "$parent" ] && mkdir -p "$parent"

    ln -s "$src" "$dst"
    log_info "Symlinked $dir -> $src"
  done
}

git_checkout_is_clean() {
  [ -z "$(git -C "$1" status --porcelain --untracked-files=all 2>/dev/null)" ]
}

reusable_worktree_cache() {
  local main_path="$1"
  local worktree_path="$2"
  local main_revision worktree_revision

  main_revision="$(git -C "$main_path" rev-parse HEAD 2>/dev/null)" || return 1
  worktree_revision="$(git -C "$worktree_path" rev-parse HEAD 2>/dev/null)" || return 1

  [ "$main_revision" = "$worktree_revision" ] || return 1
  git_checkout_is_clean "$main_path" || return 1
  git_checkout_is_clean "$worktree_path" || return 1
}

reusable_build_cache() {
  local main_path="$1"
  local worktree_path="$2"
  local main_revision worktree_revision

  main_revision="$(git -C "$main_path" rev-parse HEAD 2>/dev/null)" || return 1
  worktree_revision="$(git -C "$worktree_path" rev-parse HEAD 2>/dev/null)" || return 1

  git_checkout_is_clean "$main_path" || return 1
  git_checkout_is_clean "$worktree_path" || return 1
  git -C "$worktree_path" merge-base "$main_revision" "$worktree_revision" >/dev/null || return 1

  # Compiled artifacts are not portable across runtime versions. Dependency
  # lockfiles may differ safely because each package manager validates them,
  # but a changed toolchain declaration makes the entire cache ineligible.
  git -C "$worktree_path" diff --quiet "$main_revision" "$worktree_revision" -- \
    .tool-versions \
    mise.toml \
    .mise.toml \
    mise.local.toml \
    .mise.local.toml \
    .ruby-version \
    .node-version \
    .nvmrc \
    .python-version || return 1
}

copy_tree() {
  local source="$1"
  local destination="$2"

  [ -d "$source" ] || return 1
  [ ! -e "$destination" ] || {
    log_error "Refusing to overwrite cache copy destination: $destination"
    return 1
  }

  mkdir -p "$(dirname "$destination")"

  if [ "$(uname -s)" = "Darwin" ]; then
    # clonefile-backed copies are copy-on-write on APFS.
    if cp -cR "$source" "$destination" 2>/dev/null; then
      return 0
    fi
  elif cp --reflink=auto -a "$source" "$destination" 2>/dev/null; then
    return 0
  fi

  [ ! -e "$destination" ] || {
    log_error "Copy-on-write cache copy left a partial destination: $destination"
    return 1
  }

  cp -Rp "$source" "$destination"
}

remove_relocated_cmake_state() {
  local deps_path="$1"
  [ -d "$deps_path" ] || return 0

  # CMakeCache.txt contains absolute paths from the source checkout. Keeping it
  # makes a later native dependency rebuild fail after the tree is relocated.
  find "$deps_path" -type f -name CMakeCache.txt -delete

  find "$deps_path" -type d -name CMakeFiles -prune | while IFS= read -r cmake_dir; do
    [ -z "$cmake_dir" ] && continue
    find "$cmake_dir" -depth -delete
  done
}

sync_tracked_file_times() {
  local main_path="$1"
  local worktree_path="$2"
  local main_revision worktree_revision

  main_revision="$(git -C "$main_path" rev-parse HEAD)"
  worktree_revision="$(git -C "$worktree_path" rev-parse HEAD)"

  # Mix compiler manifests record source mtimes. Mirror times only for tracked
  # files that Git says are identical between the cache source and target.
  # Changed and newly-added files retain their worktree times so Mix sees them
  # as stale. Use one Elixir VM instead of spawning `touch` once per file;
  # large Phoenix applications can contain thousands of tracked files.
  git -C "$main_path" ls-files -z |
    WERKSFEER_MTIME_SOURCE="$main_path" \
      WERKSFEER_MTIME_TARGET="$worktree_path" \
      WERKSFEER_MTIME_SOURCE_REVISION="$main_revision" \
      WERKSFEER_MTIME_TARGET_REVISION="$worktree_revision" \
      elixir -e '
        source = System.fetch_env!("WERKSFEER_MTIME_SOURCE")
        target = System.fetch_env!("WERKSFEER_MTIME_TARGET")
        source_revision = System.fetch_env!("WERKSFEER_MTIME_SOURCE_REVISION")
        target_revision = System.fetch_env!("WERKSFEER_MTIME_TARGET_REVISION")

        changed_files =
          case System.cmd(
                 "git",
                 [
                   "-C",
                   target,
                   "diff",
                   "--name-only",
                   "-z",
                   source_revision,
                   target_revision,
                   "--"
                 ]
               ) do
            {output, 0} ->
              output
              |> :binary.split(<<0>>, [:global])
              |> MapSet.new()

            {_output, _status} ->
              System.halt(1)
          end

        IO.binread(:stdio, :eof)
        |> :binary.split(<<0>>, [:global])
        |> Enum.each(fn
          "" ->
            :ok

          relative_path ->
            source_file = Path.join(source, relative_path)
            target_file = Path.join(target, relative_path)

            with false <- MapSet.member?(changed_files, relative_path),
                 {:ok, stat} <- File.stat(source_file, time: :posix),
                 true <- File.regular?(target_file) do
              File.touch!(target_file, stat.mtime)
            end
        end)
      '
}

refresh_relocated_elixir_cache() {
  local main_path="$1"
  local worktree_path="$2"
  local deps_path="$worktree_path/deps"

  remove_relocated_cmake_state "$deps_path"
  sync_tracked_file_times "$main_path" "$worktree_path"
}

copy_build_dirs() {
  local main_path="$1"
  local worktree_path="$2"
  local project_type="$3"

  local copy_dirs
  copy_dirs="$(toml_get_array "sync" "copy_dirs")"
  [ -z "$copy_dirs" ] && copy_dirs="$(default_copy_dirs "$project_type")"
  [ -z "$copy_dirs" ] && return 0

  if ! reusable_build_cache "$main_path" "$worktree_path"; then
    log_info "Skip build cache (main checkout is not a clean, toolchain-compatible related revision)"
    return 0
  fi

  local skip_dirs
  skip_dirs="$(toml_get_array "sync" "skip")"
  local copied_elixir_build=false

  while IFS= read -r dir; do
    [ -z "$dir" ] && continue

    # Check skip list
    if [ -n "$skip_dirs" ] && echo "$skip_dirs" | grep -qxF "$dir"; then
      log_info "Skip copy $dir (in skip list)"
      continue
    fi

    local src="$main_path/$dir"
    local dst="$worktree_path/$dir"

    if [ -L "$dst" ] || [ -d "$dst" ]; then
      log_info "Skip copy $dir (already exists)"
      continue
    fi
    if [ ! -d "$src" ]; then
      log_debug "Skip copy $dir (not yet in main worktree)"
      continue
    fi

    local parent
    parent="$(dirname "$dst")"
    [ ! -d "$parent" ] && mkdir -p "$parent"

    copy_tree "$src" "$dst"
    log_info "Copied $dir"
    if [ "$project_type" = "elixir" ] && [ "$dir" = "_build" ]; then
      copied_elixir_build=true
    fi
  done <<EOF_COPY_DIRS
$copy_dirs
EOF_COPY_DIRS

  if [ "$copied_elixir_build" = true ]; then
    refresh_relocated_elixir_cache "$main_path" "$worktree_path"
    WERKSFEER_REUSED_ELIXIR_BUILD=1
  fi
}

# ---------------------------------------------------------------------------
# Database operations
# ---------------------------------------------------------------------------

has_psql() {
  command -v psql >/dev/null 2>&1
}

# Run a PostgreSQL client command (psql, dropdb, createdb) against the shared
# server. Keys set under [database] (host, port, user, password) become
# PGHOST/PGPORT/PGUSER/PGPASSWORD for this one command. Keys that are not set
# leave the caller's environment alone. They are never written to env files and
# never reach `werksfeer exec` children or setup hooks.
shared_pg() {
  local -a pg_env=()
  local value

  value="$(toml_get "database" "host" "")"
  [ -n "$value" ] && pg_env+=("PGHOST=$value")
  value="$(toml_get "database" "port" "")"
  [ -n "$value" ] && pg_env+=("PGPORT=$value")
  value="$(toml_get "database" "user" "")"
  [ -n "$value" ] && pg_env+=("PGUSER=$value")
  value="$(toml_get "database" "password" "")"
  [ -n "$value" ] && pg_env+=("PGPASSWORD=$value")

  if [ "${#pg_env[@]}" -gt 0 ]; then
    env "${pg_env[@]}" "$@"
  else
    "$@"
  fi
}

# Check once that the shared server accepts our connection. Warns with the
# first line of psql's error and a hint, and returns 1 when it does not.
shared_pg_reachable() {
  local error_output first_line
  if error_output="$(PGCONNECT_TIMEOUT="${PGCONNECT_TIMEOUT:-10}" shared_pg psql -Atqc 'select 1' -d postgres 2>&1 >/dev/null)"; then
    return 0
  fi

  first_line="$(printf '%s\n' "$error_output" | head -n 1)"
  log_warn "Cannot reach the PostgreSQL server: ${first_line:-psql failed without a message}"
  log_warn "Set host, user and password under [database] in .worktree.toml (put the password in .worktree.local.toml)"
  return 1
}

# The host the shared-server commands connect to: [database] host, else
# PGHOST, else empty (the default local socket).
shared_server_host() {
  local host
  # A service file can set any host and wins over the environment.
  if [ -n "${PGSERVICE:-}" ]; then
    printf 'PGSERVICE=%s\n' "$PGSERVICE"
    return 0
  fi
  # PGHOSTADDR is the address libpq connects to when it is set.
  host="${PGHOSTADDR:-}"
  [ -n "$host" ] || host="$(toml_get "database" "host" "")"
  [ -n "$host" ] || host="${PGHOST:-}"
  printf '%s\n' "$host"
}

# Returns 0 when the shared server is on another machine, so that other
# machines may have worktrees there that this machine knows nothing about.
# Local: no host, a socket directory, localhost, 127.0.0.1 or ::1. A service,
# a list of hosts or anything else that cannot be classified counts as remote.
shared_server_is_remote() {
  local host candidate
  # A comma anywhere means a list of hosts: libpq may fall back to any of them.
  for candidate in "${PGHOSTADDR:-}" "$(toml_get "database" "host" "")" "${PGHOST:-}"; do
    case "$candidate" in
      *,*) return 0 ;;
    esac
  done
  host="$(shared_server_host | tr '[:upper:]' '[:lower:]')"
  case "$host" in
    ""|/*|localhost|127.0.0.1|::1|"[::1]") return 1 ;;
  esac
  return 0
}

# Print the names of the databases on the shared server. Fails when the server
# cannot be asked: "could not ask" is never "does not exist".
list_server_databases() {
  local output
  output="$(shared_pg psql -d postgres -lqt 2>/dev/null)" || return 1
  printf '%s\n' "$output" | awk 'NF { print $1 }'
}

# Returns 0 when the database exists, 1 when the server says it does not, and 2
# when the server could not be asked. Callers that remove a record or drop a
# database must tell 1 from 2.
db_exists() {
  local listing
  listing="$(list_server_databases)" || return 2
  # The server cuts names at 63 bytes, so that is the name it lists.
  printf '%s\n' "$listing" | grep -qxF "$(pg_identifier "$1")"
}

get_base_db_names() {
  local project_type="$1"
  local project_name
  project_name="$(sanitize_name "$(get_project_name)")"

  # Allow override from config
  local override
  override="$(toml_get "database" "base_name" "")"
  [ -n "$override" ] && project_name="$(sanitize_name "$override")"

  local dev_suffix test_suffix
  case "$project_type" in
    rails)
      dev_suffix="$(toml_get "database" "dev_suffix" "_development")"
      test_suffix="$(toml_get "database" "test_suffix" "_test")"
      ;;
    elixir)
      dev_suffix="$(toml_get "database" "dev_suffix" "_dev")"
      test_suffix="$(toml_get "database" "test_suffix" "_test")"
      ;;
    *)
      # No DB cloning for other project types by default
      return 1
      ;;
  esac

  echo "${project_name}${dev_suffix}" "${project_name}${test_suffix}"
}

# The database names of a worktree start with "worktree_", then the project
# (the name of the main checkout), the branch and the worktree folder. PostgreSQL
# cuts identifiers at 63 bytes without an error, and the test database adds
# "_test", so a readable name over 58 bytes is cut to 47 bytes and ends with a
# short hash of the machine, project path and worktree path: "..._<10 hex
# digits>". That stays unique and stable. Printing a name with "hash" as $5 forces that form,
# which is what a name already taken by another worktree falls back to.
# Identifies this machine, so two machines that share a server and use the same
# paths (agent servers do) never derive the same hashed name. WERKSFEER_MACHINE_ID
# overrides it; it exists for tests only.
werksfeer_machine_id() {
  local id="${WERKSFEER_MACHINE_ID:-}"
  if [ -z "$id" ] && [ -r /etc/machine-id ]; then
    id="$(cat /etc/machine-id 2>/dev/null || true)"
  fi
  if [ -z "$id" ]; then
    id="$(hostname 2>/dev/null || uname -n)"
  fi
  printf '%s\n' "$id"
}

new_database_stem() {
  local project_path="$1"
  local worktree_path="$2"
  local branch="$3"
  local folder="$4"
  local force_hash="${5:-}"
  local readable hash prefix

  readable="worktree_$(sanitize_name "$(basename "$project_path")")_$(sanitize_name "$branch")_$(sanitize_name "$folder")"
  readable="$(printf '%s' "$readable" | sed 's/__*/_/g')"
  if [ "$force_hash" != "hash" ] && [ "${#readable}" -le 58 ]; then
    printf '%s\n' "$readable"
    return 0
  fi

  hash="$(printf '%s\t%s\t%s' "$(werksfeer_machine_id)" "$project_path" "$worktree_path" | werksfeer_sha256 | cut -c1-10)" || return 1
  prefix="$(printf '%s' "$readable" | cut -c1-47)"
  while [ "${prefix%_}" != "$prefix" ]; do
    prefix="${prefix%_}"
  done
  printf '%s_%s\n' "$prefix" "$hash"
}

# Returns 0 when the record names database $1 for a worktree other than the one
# at path $2, whether or not that worktree or database exists right now.
database_recorded_for_other_worktree() {
  local file
  file="$(databases_file)"
  [ -f "$file" ] || return 1
  WF_DB="$(pg_identifier "$1")" WF_WORKTREE="$2" \
    awk -F'\t' '$4 == ENVIRON["WF_DB"] && $2 != ENVIRON["WF_WORKTREE"] { found = 1 } END { exit !found }' "$file"
}

# Returns 0 when an existing worktree other than the one at path $2 uses (or a
# record of any other worktree names) database $1, or when that cannot be told.
database_used_by_other_worktree() {
  local database="$1"
  local worktree_path="$2"
  local project="$3"
  local claimed

  if database_recorded_for_other_worktree "$database" "$worktree_path"; then
    return 0
  fi

  claimed="$(claimed_databases "$worktree_path" "${project}
$(registered_project_list)")" || return 0
  printf '%s\n' "$claimed" | grep -qxF "$(pg_identifier "$database")"
}

# Print the database names the managed environment of a worktree exports as
# DATABASE_NAME and TEST_DATABASE_NAME, as the server lists them.
worktree_env_databases() {
  [ -f "${1}/.envrc" ] || return 0
  sed -n \
    -e 's/^export DATABASE_NAME="\(.*\)"$/\1/p' \
    -e 's/^export TEST_DATABASE_NAME="\(.*\)"$/\1/p' "${1}/.envrc" |
    LC_ALL=C cut -c1-63
}

# Print the value the file exports for variable $2, or nothing.
env_export_value() {
  [ -f "$1" ] || return 0
  sed -n "s/^export ${2}=\"\(.*\)\"\$/\1/p" "$1" | head -n 1
}

# Returns 0 when the managed environment of the worktree sets $2 to $3.
env_names_database() {
  grep -qxF "export ${2}=\"${3}\"" "${1}/.envrc" 2>/dev/null
}

# Pick the database name of one role ("dev" or "test") for a worktree and print
# "name<TAB>origin". The origin says what werksfeer may assume about the name:
#
# recorded  the record named it for this worktree before this run: it is ours.
# legacy    a name of 0.3.1 and earlier (worktree_<branch>_<folder>) that exists
#           and that this worktree was set up with (its own environment file
#           names it, or it has an allocation and no other worktree uses it;
#           on a remote server only the environment counts): it is ours.
# new       only a reservation. The name is the project-named form (the hashed
#           form on a remote server, or when the readable one exists or is
#           recorded for another worktree). A database that exists under it is
#           not ours; only our own successful CREATE DATABASE makes it ours.
#
# Returns 2 when the server could not be asked, so that the caller stops
# before it changes anything.
choose_database_name() {
  local role="$1"
  local project_path="$2"
  local worktree_path="$3"
  local branch="$4"
  local folder="$5"
  local suffix="" variable="DATABASE_NAME"
  if [ "$role" = "test" ]; then
    suffix="_test"
    variable="TEST_DATABASE_NAME"
  fi

  local name
  name="$(recorded_database "$worktree_path" "$role" "$project_path")"
  if [ -n "$name" ]; then
    printf '%s\trecorded\n' "$name"
    return 0
  fi

  local legacy state
  legacy="worktree_$(sanitize_name "$branch")_$(sanitize_name "$folder")${suffix}"
  name="$(pg_identifier "$legacy")"
  state=0
  db_exists "$name" || state=$?
  case "$state" in
    0)
      if [ "$role" = "dev" ] || [ "$name" != "$(pg_identifier "worktree_$(sanitize_name "$branch")_$(sanitize_name "$folder")")" ]; then
        if env_names_database "$worktree_path" "$variable" "$legacy" ||
            { ! shared_server_is_remote &&
              [ -n "$(lookup_allocation "$project_path" "$folder")" ] &&
              ! database_used_by_other_worktree "$name" "$worktree_path" "$project_path"; }; then
          log_info "Keeping the existing database $name for this worktree" >&2
          printf '%s\tlegacy\n' "$name"
          return 0
        fi
      fi
      ;;
    1) ;;
    *) return 2 ;;
  esac

  name="$(new_database_stem "$project_path" "$worktree_path" "$branch" "$folder")${suffix}"
  # On a server other machines use, two of them can see the same readable name
  # as free at the same time, so the machine-specific name is used from the
  # start there.
  if shared_server_is_remote; then
    name="$(new_database_stem "$project_path" "$worktree_path" "$branch" "$folder" hash)${suffix}"
  else
    state=0
    db_exists "$name" || state=$?
    case "$state" in
      0) name="$(new_database_stem "$project_path" "$worktree_path" "$branch" "$folder" hash)${suffix}" ;;
      1)
        if database_recorded_for_other_worktree "$name" "$worktree_path"; then
          name="$(new_database_stem "$project_path" "$worktree_path" "$branch" "$folder" hash)${suffix}"
        fi
        ;;
      *) return 2 ;;
    esac
  fi
  printf '%s\tnew\n' "$name"
}

# Clone one database from its template. Prints "name<TAB>state"; arguments are
# role, template, name, origin (see choose_database_name), project, worktree,
# branch, folder.
#
# A database is this worktree's only when the record said so before this run
# (recorded), the pre-0.4.0 rule verified it (legacy), or this run's own
# CREATE DATABASE succeeded. The state says what the caller may rely on:
#
# owned    the database exists and is this worktree's.
# pending  the database does not exist yet (no template, or the clone failed
#          and the server confirms it is absent). The name is reserved in the
#          record and exported to the worktree; the project's own tools create
#          the database under it later. A name that is exported stays recorded,
#          whether or not the database exists yet.
# none     the name is occupied by a database that is not ours, and so is the
#          machine-specific fallback. The role gets no database.
#
# A name this run only reserved ("new") that turns out to exist, whether it was
# visible before the CREATE or lost in a race, is someone else's: the
# machine-specific name is tried once. After any CREATE that did not succeed
# the name is not this run's unless the server confirms it is absent.
#
# Returns 0 normally, 1 when the record could not be updated and 2 when the
# server could not be asked. Nothing here relies on errexit.
clone_one_database() {
  local role="$1" base="$2" name="$3" origin="$4" project="$5" worktree="$6" branch="$7" folder="$8"
  local suffix="" attempt status hashed clone_error state template_state occupied
  [ "$role" = "test" ] && suffix="_test"
  # After the switch to the fallback name its reservation is unused until this
  # function reports a database for it, so failing takes it back.
  fallback_failed() {
    [ "$attempt" -eq 2 ] && { unrecord_database "$project" "$worktree" "$role" || true; }
    return "$1"
  }

  for attempt in 1 2; do
    occupied=false
    state=0
    db_exists "$name" || state=$?
    hashed="$(new_database_stem "$project" "$worktree" "$branch" "$folder" hash)${suffix}"

    case "$state" in
      0)
        if [ "$origin" != "new" ]; then
          log_info "Database $name already exists, skipping" >&2
          printf '%s\towned\n' "$name"
          return 0
        fi
        # A database exists under a name this run only reserved.
        log_warn "Database $name exists and is not this worktree's" >&2
        occupied=true
        ;;
      1)
        template_state=0
        db_exists "$base" || template_state=$?
        case "$template_state" in
          0) ;;
          1)
            log_warn "Template database $base not found, skipping $role DB clone" >&2
            printf '%s\tpending\n' "$name"
            return 0
            ;;
          *) fallback_failed 2; return ;;
        esac

        log_info "Cloning $base -> $name" >&2
        shared_pg psql -d postgres -q -c "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = '${base}' AND pid <> pg_backend_pid();" >/dev/null 2>&1 || true
        status=0
        # VERBOSITY=verbose puts the SQLSTATE in the error line in any language.
        clone_error="$(shared_pg psql -d postgres -q -v ON_ERROR_STOP=1 -v VERBOSITY=verbose -c "CREATE DATABASE \"${name}\" WITH TEMPLATE \"${base}\";" 2>&1 >/dev/null)" || status=$?
        if [ "$status" -eq 0 ]; then
          printf '%s\towned\n' "$name"
          return 0
        fi
        printf '%s\n' "$clone_error" >&2

        case "$clone_error" in
          *"42P04"*)
            # duplicate_database: someone else won the race for this name.
            log_warn "Database $name was created by someone else in the meantime" >&2
            occupied=true
            ;;
          *)
            log_error "Failed to clone $base -> $name" >&2
            # The failed CREATE says nothing about who owns the name: look.
            state=0
            db_exists "$name" || state=$?
            case "$state" in
              1)
                printf '%s\tpending\n' "$name"
                return 0
                ;;
              0) occupied=true ;;
              *) fallback_failed 2; return ;;
            esac
            ;;
        esac
        ;;
      *) fallback_failed 2; return ;;
    esac

    if [ "$occupied" = true ] && [ "$attempt" -eq 1 ] && [ "$hashed" != "$name" ]; then
      log_warn "Trying $hashed instead" >&2
      # The record must stop naming the occupied database before anything else.
      if ! record_database "$project" "$worktree" "$role" "$hashed"; then
        unrecord_database "$project" "$worktree" "$role" || true
        log_error "Cannot update the database record: stopping" >&2
        return 1
      fi
      name="$hashed"
      origin="new"
      continue
    fi
    log_warn "The $role database stays unconfigured: no database of this worktree's own was found or created" >&2
    printf '\tnone\n'
    return 0
  done
  return 2
}

# Leave the role as it was before this run: remove the reservation this run made.
release_reservation() {
  local project="$1" worktree="$2" role="$3" origin="$4" state="$5"
  # A recorded or verified legacy name, and a database this run created, stay.
  if [ "$origin" = "new" ] && [ "$state" != "owned" ]; then
    unrecord_database "$project" "$worktree" "$role" || log_warn "Could not remove the reservation of the $role database from the record"
  fi
  return 0
}

clone_databases() {
  local project_type="$1"
  WERKSFEER_DB_UNCONFIGURED=""
  WERKSFEER_DB_PENDING=""
  WERKSFEER_DB_SKIPPED=""

  if ! has_psql; then
    log_warn "psql not found, skipping database cloning"
    WERKSFEER_DB_SKIPPED=1
    return 0
  fi

  local db_names
  db_names="$(get_base_db_names "$project_type")" || {
    log_info "No database cloning needed for project type: $project_type"
    return 0
  }

  local base_dev base_test
  base_dev="$(echo "$db_names" | awk '{print $1}')"
  base_test="$(echo "$db_names" | awk '{print $2}')"

  if ! shared_pg_reachable; then
    log_warn "Skipping database cloning"
    WERKSFEER_DB_SKIPPED=1
    return 0
  fi

  # Every catalog check below relies on being able to list the databases. A
  # server that accepts the connection but cannot list them stops setup here,
  # before the environment of an existing worktree is rewritten.
  if ! list_server_databases > /dev/null; then
    log_error "Cannot list the databases on the PostgreSQL server: stopping before the record and the environment files change"
    return 1
  fi

  local record_project record_worktree clone_branch clone_folder
  record_project="$(get_main_worktree_path)"
  record_worktree="$(pwd -P)"
  clone_branch="$(get_worktree_branch)"
  clone_folder="$(get_worktree_name)"

  # Choosing a name and reserving it in the record is one step under the lock:
  # another setup that picks next sees the record and takes a different name.
  # The lock is not held while the databases are cloned, which can take long.
  # After any failure a role is either as it was before this run or fully this
  # worktree's: owned databases stay recorded, unused reservations are removed.
  local dev_choice test_choice dev_origin test_origin status=0
  local dev_state="" test_state=""
  state_lock_acquire || return 1
  dev_choice="$(choose_database_name dev "$record_project" "$record_worktree" "$clone_branch" "$clone_folder")" || status=$?
  if [ "$status" -eq 0 ]; then
    test_choice="$(choose_database_name test "$record_project" "$record_worktree" "$clone_branch" "$clone_folder")" || status=$?
  fi
  if [ "$status" -ne 0 ]; then
    state_lock_release
    log_error "Cannot ask the PostgreSQL server which databases exist: stopping before anything is changed"
    return 1
  fi
  NEW_DEV_DB="${dev_choice%%"$TAB"*}"
  dev_origin="${dev_choice#*"$TAB"}"
  NEW_TEST_DB="${test_choice%%"$TAB"*}"
  test_origin="${test_choice#*"$TAB"}"
  # Two names that end up as the same database would share its data.
  if [ "$(pg_identifier "$NEW_TEST_DB")" = "$(pg_identifier "$NEW_DEV_DB")" ]; then
    NEW_TEST_DB="$(new_database_stem "$record_project" "$record_worktree" "$clone_branch" "$clone_folder" hash)_test"
    test_origin="new"
  fi
  if ! record_database "$record_project" "$record_worktree" dev "$NEW_DEV_DB" ||
      ! record_database "$record_project" "$record_worktree" test "$NEW_TEST_DB"; then
    release_reservation "$record_project" "$record_worktree" dev "$dev_origin" ""
    release_reservation "$record_project" "$record_worktree" test "$test_origin" ""
    state_lock_release
    log_error "Cannot update the database record: stopping before the environment files change"
    return 1
  fi
  state_lock_release

  local dev_result test_result
  status=0
  dev_result="$(clone_one_database dev "$base_dev" "$NEW_DEV_DB" "$dev_origin" "$record_project" "$record_worktree" "$clone_branch" "$clone_folder")" || status=$?
  if [ "$status" -eq 0 ]; then
    dev_state="${dev_result#*"$TAB"}"
    test_result="$(clone_one_database test "$base_test" "$NEW_TEST_DB" "$test_origin" "$record_project" "$record_worktree" "$clone_branch" "$clone_folder")" || status=$?
    [ "$status" -ne 0 ] || test_state="${test_result#*"$TAB"}"
  fi
  if [ "$status" -ne 0 ]; then
    # What this run created stays recorded; unused reservations go.
    release_reservation "$record_project" "$record_worktree" dev "$dev_origin" "$dev_state"
    release_reservation "$record_project" "$record_worktree" test "$test_origin" "$test_state"
    log_error "Stopping before the environment files change: the PostgreSQL server could not be asked, or the record could not be updated"
    return 1
  fi
  NEW_DEV_DB="${dev_result%%"$TAB"*}"
  NEW_TEST_DB="${test_result%%"$TAB"*}"

  # What is exported is recorded, and what is not recorded is not exported:
  # - owned and pending names stay in the record. A pending database does not
  #   exist yet; the project's own tools create it under the exported name
  #   later, so its absence now says nothing about ownership.
  # - a role without a database has no record and no variable.
  local role state name
  for role in dev test; do
    if [ "$role" = "dev" ]; then
      name="$NEW_DEV_DB"; state="$dev_state"
    else
      name="$NEW_TEST_DB"; state="$test_state"
    fi
    case "$state" in
      owned) ;;
      pending) [ "$role" != "dev" ] || WERKSFEER_DB_PENDING=1 ;;
      *)
        if ! unrecord_database "$record_project" "$record_worktree" "$role"; then
          log_error "Cannot remove the reservation of the $role database from the record: stopping"
          return 1
        fi
        WERKSFEER_DB_UNCONFIGURED=1
        ;;
    esac
    # Check the invariant before the environment is written.
    local recorded
    recorded="$(recorded_database "$record_worktree" "$role" "$record_project")"
    if [ -n "$name" ] && [ "$recorded" != "$(pg_identifier "$name")" ]; then
      log_error "The $role database $name would be exported without a record: stopping"
      return 1
    fi
    if [ -z "$name" ] && [ -n "$recorded" ]; then
      log_error "The $role database has no name but is still recorded as $recorded: stopping"
      return 1
    fi
  done
  return 0
}

use_private_postgres_cluster() {
  service_enabled "postgres"
}

set_private_cluster_database_names() {
  local project_type="$1"
  local db_names

  db_names="$(get_base_db_names "$project_type")" || return 0
  NEW_DEV_DB="$(echo "$db_names" | awk '{print $1}')"
  NEW_TEST_DB="$(echo "$db_names" | awk '{print $2}')"
}

setup_databases() {
  local project_type="$1"
  local project_root="$2"

  if use_private_postgres_cluster; then
    set_private_cluster_database_names "$project_type"
    run_service_action "postgres" "template_hydrate" "$project_root" "$project_type"
    run_services_action "prepare" "$project_root"
  else
    clone_databases "$project_type"
  fi
}

# ---------------------------------------------------------------------------
# Environment overrides (DB names, ports, Redis)
# ---------------------------------------------------------------------------

default_base_port() {
  case "$1" in
    rails)  echo 3000 ;;
    elixir) echo 4000 ;;
    python) echo 8000 ;;
    node)   echo 3000 ;;
    *)      echo 3000 ;;
  esac
}

default_redis_url() {
  case "$1" in
    rails) echo "redis://localhost:6379" ;;
    *)     echo "" ;;
  esac
}

format_env_assignments() {
  local prefix="$1"
  local assignments="$2"
  local key value

  while IFS='=' read -r key value; do
    [ -z "$key" ] && continue
    printf '%s%s="%s"\n' "$prefix" "$key" "$value"
  done <<EOF_ASSIGNMENTS
$assignments
EOF_ASSIGNMENTS
}

write_managed_env_block() {
  local envfile="$1"
  local contents="$2"
  local start_marker="# >>> werksfeer managed environment >>>"
  local end_marker="# <<< werksfeer managed environment <<<"
  local tmp="${envfile}.werksfeer.$$"

  (umask 077 && : > "$tmp")

  if [ -f "$envfile" ]; then
    awk -v start="$start_marker" -v finish="$end_marker" '
      $0 == start { managed = 1; next }
      $0 == finish { managed = 0; next }
      !managed { print }
    ' "$envfile" > "$tmp"

    local mode
    if mode="$(stat -f '%Lp' "$envfile" 2>/dev/null)"; then
      chmod "$mode" "$tmp"
    elif mode="$(stat -c '%a' "$envfile" 2>/dev/null)"; then
      chmod "$mode" "$tmp"
    fi
  fi

  {
    printf '\n%s\n' "$start_marker"
    printf '%s\n' "$contents"
    printf '%s\n' "$end_marker"
  } >> "$tmp"

  mv "$tmp" "$envfile"
  log_info "Wrote managed environment to $envfile"
}

managed_shell_environment() {
  local assignments="$1"

  format_env_assignments "export " "$assignments"
  if [ -n "$(service_names)" ]; then
    cat <<'EOF_SERVICE_START'
if command -v pg_isready >/dev/null 2>&1 && ! pg_isready -q -h "$DATABASE_HOST" 2>/dev/null; then
  werksfeer services start >/dev/null 2>&1
fi
EOF_SERVICE_START
  fi

}

allow_project_environment() {
  if command -v direnv >/dev/null 2>&1 && [ -f ".envrc" ]; then
    direnv allow . 2>/dev/null || true
  fi
}

write_env_overrides() {
  local project_type="$1"
  local worktree_root="$2"
  local wt_name project_root existing base_redis
  wt_name="$(get_worktree_name)"
  project_root="$(get_main_worktree_path)"
  existing="$(lookup_allocation "$project_root" "$wt_name")"
  base_redis="$(toml_get "redis" "url" "$(default_redis_url "$project_type")")"

  # Choosing free ports and registering them must not interleave with another
  # setup, or two worktrees could get the same port.
  state_lock_acquire || return 1
  existing="$(lookup_allocation "$project_root" "$wt_name")"
  local wt_port redis_db redis_port=""
  if [ -n "$existing" ]; then
    wt_port="$(echo "$existing" | cut -f1)"
    redis_db="$(echo "$existing" | cut -f2)"
    redis_port="$(echo "$existing" | cut -f3)"
    log_debug "Reusing allocation: port=$wt_port redis_db=$redis_db redis_port=$redis_port"
  else
    local base_port
    base_port="$(toml_get "port" "base" "$(default_base_port "$project_type")")"
    wt_port="$(allocate_port "$base_port")"
    redis_db="$(allocate_redis_db "$project_root")"
  fi

  if [ -n "$base_redis" ] && [ -z "$redis_port" ]; then
    local base_redis_port
    base_redis_port="$(echo "$base_redis" | grep -oE ':[0-9]+' | tail -1 | tr -d ':')"
    base_redis_port="${base_redis_port:-6379}"
    redis_port="$(allocate_redis_port "$base_redis_port")"
  fi

  if [ -z "$existing" ]; then
    register_allocation "$project_root" "$wt_name" "$wt_port" "$redis_db" "$redis_port"
  fi
  state_lock_release

  local wt_redis=""
  if [ -n "$base_redis" ]; then
    local base_stripped
    base_stripped="$(echo "$base_redis" | sed 's|/[0-9]*$||')"
    if [ -n "$redis_port" ]; then
      wt_redis="$(echo "$base_stripped" | sed "s|:[0-9]*$|:${redis_port}|")/${redis_db}"
    else
      wt_redis="${base_stripped}/${redis_db}"
    fi
  fi

  local dev_db="${NEW_DEV_DB:-}"
  local test_db="${NEW_TEST_DB:-}"
  # The database part was skipped because the server or psql was not available:
  # an existing worktree keeps the database variables it already has.
  if [ "${WERKSFEER_DB_SKIPPED:-}" = "1" ]; then
    [ -n "$dev_db" ] || dev_db="$(env_export_value ".envrc" DATABASE_NAME)"
    [ -n "$test_db" ] || test_db="$(env_export_value ".envrc" TEST_DATABASE_NAME)"
  fi
  local service_env
  service_env="$(services_environment "$worktree_root")"

  local common_assignments="PORT=${wt_port}"
  [ -n "$wt_redis" ] && common_assignments="${common_assignments}
REDIS_URL=${wt_redis}"
  [ -n "$redis_port" ] && common_assignments="${common_assignments}
REDIS_PORT=${redis_port}"
  [ -n "$dev_db" ] && common_assignments="${common_assignments}
DATABASE_NAME=${dev_db}"
  [ -n "$test_db" ] && common_assignments="${common_assignments}
TEST_DATABASE_NAME=${test_db}"
  [ -n "$service_env" ] && common_assignments="${common_assignments}
${service_env}"

  case "$project_type" in
    rails)
      write_managed_env_block ".env.local" "$(format_env_assignments "" "$common_assignments")"

      local test_assignments=""
      [ -n "$test_db" ] && test_assignments="TEST_DATABASE_NAME=${test_db}"
      [ -n "$service_env" ] && test_assignments="${test_assignments}
${service_env}"
      write_managed_env_block ".env.test.local" "$(format_env_assignments "" "$test_assignments")"
      ;;
    python|node)
      write_managed_env_block ".env" "$(format_env_assignments "" "$common_assignments")"
      ;;
  esac

  # Every framework gets the same shell contract. Framework-specific dotenv
  # files above remain available for processes that load them themselves.
  write_managed_env_block ".envrc" "$(managed_shell_environment "$common_assignments")"
  allow_project_environment

  log_info "Port: ${wt_port}"
  if [ -n "$wt_redis" ]; then
    log_info "Redis: ${wt_redis}"
  fi
}

# ---------------------------------------------------------------------------
# Setup commands
# ---------------------------------------------------------------------------

detect_node_pm() {
  local root="$1"
  if [ -f "$root/bun.lockb" ] || [ -f "$root/bun.lock" ]; then echo "bun install --frozen-lockfile"
  elif [ -f "$root/pnpm-lock.yaml" ]; then echo "pnpm install --frozen-lockfile"
  elif [ -f "$root/yarn.lock" ]; then echo "yarn install --frozen-lockfile"
  elif [ -f "$root/package-lock.json" ] || [ -f "$root/npm-shrinkwrap.json" ]; then echo "npm ci"
  else echo "npm install"
  fi
}

project_mise_bin() {
  local project_root
  project_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

  if [ ! -f "$project_root/.tool-versions" ] &&
      [ ! -f "$project_root/mise.toml" ] &&
      [ ! -f "$project_root/.mise.toml" ] &&
      [ ! -f "$project_root/mise.local.toml" ] &&
      [ ! -f "$project_root/.mise.local.toml" ]; then
    return 1
  fi

  command -v mise 2>/dev/null
}

project_asdf_bin() {
  local project_root
  project_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

  [ -f "$project_root/.tool-versions" ] || return 1
  command -v asdf 2>/dev/null
}

run_with_mise() {
  local mise_bin="$1"
  shift
  local bin_path=""
  local bin_paths=""

  while IFS= read -r bin_path; do
    [ -z "$bin_path" ] && continue
    if [ -n "$bin_paths" ]; then
      bin_paths="${bin_paths}:${bin_path}"
    else
      bin_paths="$bin_path"
    fi
  done <<< "$("$mise_bin" bin-paths)"

  if [ -n "$bin_paths" ]; then
    # Some GUI harnesses prepend system paths after shell activation. Keep the
    # repository-pinned binaries first even in that inherited environment.
    "$mise_bin" exec -- env PATH="${bin_paths}:${PATH}" "$@"
  else
    "$mise_bin" exec -- "$@"
  fi
}

run_with_asdf() {
  local asdf_bin="$1"
  shift
  local asdf_data_dir="${ASDF_DATA_DIR:-$HOME/.asdf}"
  local shims_dir="${asdf_data_dir}/shims"

  if [ -d "$shims_dir" ]; then
    # asdf selects the .tool-versions entry through its shims. Put them first
    # for GUI harnesses whose inherited PATH puts system tools ahead of asdf.
    env PATH="${shims_dir}:${PATH}" "$@"
  else
    "$asdf_bin" exec "$@"
  fi
}

# Print the NAME=value pairs of the managed environment block of an .envrc, so
# that they can be passed to a command without direnv. Only plain
# `export NAME="value"` lines inside the block are read; nothing is sourced.
managed_env_assignments() {
  [ -f "$1" ] || return 0
  awk '
    $0 == "# >>> werksfeer managed environment >>>" { inside = 1; next }
    $0 == "# <<< werksfeer managed environment <<<" { inside = 0; next }
    inside && /^export [A-Za-z_][A-Za-z0-9_]*=".*"$/ {
      line = substr($0, 8)
      name = line; sub(/=.*/, "", name)
      value = line; sub(/^[^=]*="/, "", value); sub(/"$/, "", value)
      print name "=" value
    }' "$1"
}

run_in_project_environment() {
  local mise_bin=""
  local asdf_bin=""
  local -a managed=()
  local assignment

  # Without direnv nothing loads the .envrc, so the managed variables (the
  # database names, the port) are passed in the command's environment.
  if ! { command -v direnv >/dev/null 2>&1 && [ -f ".envrc" ]; }; then
    while IFS= read -r assignment; do
      [ -n "$assignment" ] && managed+=("$assignment")
    done <<EOF_MANAGED
$(managed_env_assignments ".envrc")
EOF_MANAGED
    if [ "${#managed[@]}" -gt 0 ]; then
      set -- env "${managed[@]}" "$@"
    fi
  fi
  mise_bin="$(project_mise_bin)" || true
  if [ -z "$mise_bin" ]; then
    asdf_bin="$(project_asdf_bin)" || true
  fi

  if command -v direnv >/dev/null 2>&1 && [ -f ".envrc" ]; then
    if [ -n "$mise_bin" ]; then
      direnv exec . "${WERKSFEER_SCRIPT_DIR}/werksfeer" --mise-exec "$mise_bin" "$@"
    elif [ -n "$asdf_bin" ]; then
      direnv exec . "${WERKSFEER_SCRIPT_DIR}/werksfeer" --asdf-exec "$asdf_bin" "$@"
    else
      direnv exec . "$@"
    fi
  elif [ -n "$mise_bin" ]; then
    run_with_mise "$mise_bin" "$@"
  elif [ -n "$asdf_bin" ]; then
    run_with_asdf "$asdf_bin" "$@"
  else
    "$@"
  fi
}

run_shell_in_project_environment() {
  run_in_project_environment /bin/bash -c "$1"
}

install_node_dependencies() {
  [ -f "package.json" ] || return 0

  if [ "${WERKSFEER_REUSED_NODE_DEPENDENCIES:-0}" = "1" ]; then
    log_info "Reused node_modules is ready, skipping package installation"
    return 0
  fi

  if [ -L "node_modules" ]; then
    log_info "Shared node_modules is already linked, skipping package installation"
    return 0
  fi

  local pm_cmd
  pm_cmd="$(toml_get "setup" "node_install" "")"
  [ -z "$pm_cmd" ] && pm_cmd="$(detect_node_pm "$(pwd)")"
  log_step "Running $pm_cmd"
  run_shell_in_project_environment "$pm_cmd"
}

run_post_dependencies_hook() {
  local hook
  hook="$(toml_get "hooks" "post_dependencies" "")"
  [ -z "$hook" ] && return 0

  log_step "Running post-dependencies hook"
  run_shell_in_project_environment "$hook"
}

run_dependency_setup() {
  local project_type="$1"

  case "$project_type" in
    rails)
      log_step "Running bundle install"
      run_in_project_environment bundle install
      install_node_dependencies
      ;;
    elixir)
      if [ "${WERKSFEER_REUSED_ELIXIR_BUILD:-0}" = "1" ] &&
          run_in_project_environment mix deps.loadpaths --no-compile >/dev/null 2>&1 &&
          run_in_project_environment env MIX_ENV=test mix deps.loadpaths --no-compile >/dev/null 2>&1; then
        log_info "Reused Elixir dependencies are ready, skipping mix deps.get"
      else
        log_step "Running mix deps.get"
        run_in_project_environment mix deps.get
        log_step "Running mix deps.get for test"
        run_in_project_environment env MIX_ENV=test mix deps.get
      fi
      log_step "Running mix compile"
      run_in_project_environment mix compile
      install_node_dependencies
      ;;
    python)
      if [ -f "pyproject.toml" ] && command -v uv >/dev/null 2>&1; then
        log_step "Running uv sync"
        run_in_project_environment uv sync
      elif [ -f "Pipfile" ] && command -v pipenv >/dev/null 2>&1; then
        log_step "Running pipenv install"
        run_in_project_environment pipenv install
      elif [ -f "requirements.txt" ]; then
        log_step "Running pip install -r requirements.txt"
        run_in_project_environment pip install -r requirements.txt
      fi
      ;;
    node)
      install_node_dependencies
      ;;
    *)
      log_info "Unknown project type, no dependency setup to run"
      ;;
  esac
}

run_database_setup() {
  local project_type="$1"
  local worktree_root="$2"

  # Without a database of its own the worktree must not set up whichever
  # database the application would fall back to.
  if [ "${WERKSFEER_DB_UNCONFIGURED:-}" = "1" ]; then
    log_warn "This worktree has no database of its own, skipping database setup"
    return 0
  fi

  case "$project_type" in
    rails)
      if [ -x "bin/rails" ]; then
        log_step "Running bin/rails db:prepare"
        run_in_project_environment bin/rails db:prepare
        log_step "Running bin/rails db:prepare for test"
        run_in_project_environment env RAILS_ENV=test bin/rails db:prepare
      fi
      ;;
    elixir)

      # Private clusters start empty and migrations remain application-owned.
      # Shared clones already contain the source database's schema and data.
      if use_private_postgres_cluster; then
        if postgres_setting_enabled "$worktree_root" &&
            run_service_action "postgres" "database_exists" "$worktree_root" "$NEW_DEV_DB"; then
          log_step "Migrating the private development database"
          run_in_project_environment mix ecto.migrate
        elif postgres_setting_enabled "$worktree_root"; then
          log_step "Creating, migrating, and seeding the private development database"
          run_in_project_environment mix ecto.setup
        else
          log_step "Creating and migrating the configured development database"
          run_in_project_environment mix ecto.create --quiet
          run_in_project_environment mix ecto.migrate
        fi

        log_step "Creating and migrating the private test database"
        run_in_project_environment env MIX_ENV=test mix ecto.create --quiet
        run_in_project_environment env MIX_ENV=test mix ecto.migrate --quiet
      elif [ -z "${NEW_DEV_DB:-}" ] || [ "${WERKSFEER_DB_PENDING:-}" = "1" ]; then
        log_step "Running mix ecto.setup"
        run_in_project_environment mix ecto.setup
      else
        log_info "Databases already cloned, skipping mix ecto.setup"
      fi
      ;;
  esac
}

run_setup_command() {
  local project_type="$1"
  local worktree_root="$2"

  # A custom command retains its historical full-override behavior.
  local custom_cmd
  custom_cmd="$(toml_get "setup" "command" "")"

  if [ -n "$custom_cmd" ]; then
    log_step "Running custom setup: $custom_cmd"
    run_shell_in_project_environment "$custom_cmd"
    return
  fi

  run_dependency_setup "$project_type"
  run_post_dependencies_hook
  run_database_setup "$project_type" "$worktree_root"
}

# ---------------------------------------------------------------------------
# Project registry (for --prune-all)
# ---------------------------------------------------------------------------

registry_file() {
  echo "${XDG_DATA_HOME:-$HOME/.local/share}/werksfeer/projects"
}

register_project() {
  local reg
  reg="$(registry_file)"
  local project_root
  project_root="$(get_main_worktree_path)"

  mkdir -p "$(dirname "$reg")"
  if ! grep -qxF "$project_root" "$reg" 2>/dev/null; then
    echo "$project_root" >> "$reg"
  fi
}

# ---------------------------------------------------------------------------
# Database record (which databases werksfeer created for which worktree)
# ---------------------------------------------------------------------------
# File: ~/.local/share/werksfeer/databases
# Format: project_path<TAB>worktree_path<TAB>role<TAB>database
# One line per database; role is "dev" or "test". Cleanup and prune go by this
# record instead of guessing from database names.

TAB="$(printf '\t')"

databases_file() {
  echo "${XDG_DATA_HOME:-$HOME/.local/share}/werksfeer/databases"
}

# Print the record lines of a worktree path, optionally only for one project.
recorded_lines() {
  local file
  file="$(databases_file)"
  [ -f "$file" ] || return 0
  WF_WORKTREE="$1" WF_PROJECT="${2:-}" awk -F'\t' \
    '$2 == ENVIRON["WF_WORKTREE"] && (ENVIRON["WF_PROJECT"] == "" || $1 == ENVIRON["WF_PROJECT"])' "$file"
}

# Print the recorded database of one role for a worktree, or nothing.
recorded_database() {
  recorded_lines "$1" "${3:-}" | awk -F'\t' -v role="$2" '$3 == role { print $4; exit }'
}

# Record a database for a worktree, replacing an earlier one of the same role.
# The file is rewritten through a temp file and a rename.
record_database() {
  local project="$1" worktree="$2" role="$3" database
  local file tmp
  database="$(pg_identifier "$4")"
  file="$(databases_file)"

  # Every step is checked: errexit does not apply inside a function that is
  # called on the left of || or in an if, and a half-written record is worse
  # than a failed one.
  case "${project}${worktree}" in
    *"$TAB"*|*$'\n'*)
      log_warn "Cannot record $database: a tab or newline in a path cannot be stored"
      return 1
      ;;
  esac

  state_lock_acquire || return 1
  tmp="${file}.tmp.$$"
  mkdir -p "$(dirname "$file")" || { state_lock_release; return 1; }
  : > "$tmp" || { state_lock_release; return 1; }
  if [ -f "$file" ]; then
    WF_PROJECT="$project" WF_WORKTREE="$worktree" WF_ROLE="$role" awk -F'\t' \
      '!($1 == ENVIRON["WF_PROJECT"] && $2 == ENVIRON["WF_WORKTREE"] && $3 == ENVIRON["WF_ROLE"])' "$file" > "$tmp" ||
      { rm -f "$tmp"; state_lock_release; return 1; }
  fi
  printf '%s\t%s\t%s\t%s\n' "$project" "$worktree" "$role" "$database" >> "$tmp" ||
    { rm -f "$tmp"; state_lock_release; return 1; }
  mv "$tmp" "$file" || { rm -f "$tmp"; state_lock_release; return 1; }
  state_lock_release
}

# Remove the record line of one role of a worktree. Returns 1 when that failed.
unrecord_database() {
  local project="$1" worktree="$2" role="$3"
  local file tmp
  file="$(databases_file)"
  [ -f "$file" ] || return 0

  state_lock_acquire || return 1
  tmp="${file}.tmp.$$"
  WF_PROJECT="$project" WF_WORKTREE="$worktree" WF_ROLE="$role" awk -F'\t' \
    '!($1 == ENVIRON["WF_PROJECT"] && $2 == ENVIRON["WF_WORKTREE"] && $3 == ENVIRON["WF_ROLE"])' "$file" > "$tmp" ||
    { rm -f "$tmp"; state_lock_release; return 1; }
  if [ -s "$tmp" ]; then
    mv "$tmp" "$file" || { rm -f "$tmp"; state_lock_release; return 1; }
  else
    rm -f "$tmp" "$file" || { state_lock_release; return 1; }
  fi
  state_lock_release
}

# Remove every record line of a worktree path (of one project when given).
forget_worktree_databases() {
  local worktree="$1" project="${2:-}"
  local file tmp
  file="$(databases_file)"
  [ -f "$file" ] || return 0

  state_lock_acquire || return 1
  tmp="${file}.tmp.$$"
  WF_WORKTREE="$worktree" WF_PROJECT="$project" awk -F'\t' \
    '!($2 == ENVIRON["WF_WORKTREE"] && (ENVIRON["WF_PROJECT"] == "" || $1 == ENVIRON["WF_PROJECT"]))' "$file" > "$tmp" ||
    { rm -f "$tmp"; state_lock_release; return 1; }
  mv "$tmp" "$file" || { rm -f "$tmp"; state_lock_release; return 1; }
  state_lock_release
}

# Resolve a path the way git reports worktrees: absolute, symlinks resolved in
# the part that exists (before any ".." is applied), no trailing slash.
# Components that are already gone are kept as given.
normalize_path() {
  local path="$1" cur component missing=0

  case "$path" in
    /*) cur="/" ;;
    *) cur="$(pwd -P)" ;;
  esac

  # Walk the components in order. Each one that exists is resolved on the
  # spot (symlinks included), so ".." always applies to the real parent; what
  # does not exist yet is kept as given.
  while IFS= read -r component; do
    case "$component" in
      ""|.) ;;
      ..)
        cur="$(dirname "$cur")"
        if [ -d "$cur" ]; then
          cur="$(cd "$cur" && pwd -P)"
          missing=0
        fi
        ;;
      *)
        if [ "$missing" -eq 0 ] && [ -d "${cur%/}/${component}" ]; then
          cur="$(cd "${cur%/}/${component}" && pwd -P)"
        else
          missing=1
          cur="${cur%/}/${component}"
        fi
        ;;
    esac
  done <<EOF_PARTS
$(printf '%s\n' "$path" | tr '/' '\n')
EOF_PARTS

  printf '%s\n' "$cur"
}

# PostgreSQL cuts identifiers at 63 bytes without an error, so a longer name
# is the same database as its first 63 bytes.
pg_identifier() {
  printf '%s' "$1" | LC_ALL=C cut -c1-63
}

registered_project_list() {
  local reg
  reg="$(registry_file)"
  [ -f "$reg" ] && [ -r "$reg" ] || return 0
  cat "$reg"
}

# Print "worktree_path<TAB>database" for the databases each existing worktree
# of a project (a main checkout) claims: the ones recorded for it, and the
# names it would have by the naming of 0.3.1 and earlier and by the current
# naming. We cannot strip
# _test to infer stems because the worktree name itself may end with _test
# (e.g. wt-ragout-test).
#
# Returns 1 when the project cannot be inspected completely (the worktree list
# fails, or the branch of a worktree that exists cannot be read). Callers must
# not drop databases against an incomplete list. Paths come from the porcelain
# output, so a path with spaces stays whole. A listed worktree whose directory
# is gone claims nothing.
project_worktree_claims() {
  local project_dir="$1"
  local listing wt_line wt_path wt_basename wt_branch recorded_line new_stem env_db

  if ! (cd "$project_dir" && is_git_repo); then
    # A checkout that git cannot read is not a project without worktrees.
    [ -e "${project_dir}/.git" ] && return 1
    return 0
  fi

  listing="$(cd "$project_dir" && git worktree list --porcelain 2>/dev/null)" || return 1

  while IFS= read -r wt_line; do
    case "$wt_line" in
      "worktree "*) wt_path="${wt_line#worktree }" ;;
      *) continue ;;
    esac
    [ -d "$wt_path" ] || continue
    wt_basename="$(sanitize_name "$(basename "$wt_path")")"
    wt_branch="$(cd "$wt_path" 2>/dev/null && sanitize_name "$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo HEAD)")" || return 1
    [ -n "$wt_branch" ] || return 1

    printf '%s\t%s\n' \
      "$wt_path" "$(pg_identifier "worktree_${wt_branch}_${wt_basename}")" \
      "$wt_path" "$(pg_identifier "worktree_${wt_branch}_${wt_basename}_test")"

    # The name this version would give it, in case its record is lost.
    new_stem="$(new_database_stem "$project_dir" "$wt_path" "$wt_branch" "$wt_basename")" || return 1
    printf '%s\t%s\n' \
      "$wt_path" "$new_stem" \
      "$wt_path" "${new_stem}_test"
    # And the hashed form a name collision falls back to.
    new_stem="$(new_database_stem "$project_dir" "$wt_path" "$wt_branch" "$wt_basename" hash)" || return 1
    printf '%s\t%s\n' \
      "$wt_path" "$new_stem" \
      "$wt_path" "${new_stem}_test"

    # What the worktree's own environment exports: after a branch switch it can
    # still name a database that no name rule or record gives it any more.
    while IFS= read -r env_db; do
      [ -n "$env_db" ] || continue
      printf '%s\t%s\n' "$wt_path" "$env_db"
    done <<EOF_ENV
$(worktree_env_databases "$wt_path")
EOF_ENV

    while IFS= read -r recorded_line; do
      [ -n "$recorded_line" ] || continue
      printf '%s\t%s\n' "$wt_path" "$(printf '%s' "$recorded_line" | cut -f4)"
    done <<EOF_RECORDED
$(recorded_lines "$wt_path")
EOF_RECORDED
  done <<EOF_LISTING
$listing
EOF_LISTING
}

# Print the databases that existing worktrees claim, one per line, leaving out
# the worktree at path $1 (empty for none). $2 holds the main checkouts to
# inspect, one per line; a checkout whose directory is gone claims nothing.
# Recorded databases of any worktree that still exists count too.
#
# Returns 1 (after saying which project) when a project cannot be inspected.
claimed_databases() {
  local excluded="$1"
  local projects="$2"
  local project claims r_project r_path r_role r_db file

  while IFS= read -r project || [ -n "$project" ]; do
    [ -n "$project" ] || continue
    [ -d "$project" ] || continue
    if ! claims="$(project_worktree_claims "$project")"; then
      log_warn "Cannot read the worktrees of $project"
      return 1
    fi
    if [ -n "$claims" ]; then
      printf '%s\n' "$claims" | WF_EXCLUDED="$excluded" awk -F'\t' '$1 != ENVIRON["WF_EXCLUDED"] { print $2 }'
    fi
  done <<EOF_PROJECTS
$projects
EOF_PROJECTS

  file="$(databases_file)"
  if [ -f "$file" ]; then
    while IFS="$TAB" read -r r_project r_path r_role r_db || [ -n "$r_db" ]; do
      [ -n "$r_db" ] || continue
      [ "$r_path" = "$excluded" ] && continue
      if [ -d "$r_path" ]; then
        printf '%s\n' "$r_db"
      fi
    done < "$file"
  fi
  return 0
}

# ---------------------------------------------------------------------------
# Cleanup (drop databases for a specific worktree)
# ---------------------------------------------------------------------------

# Print the main checkouts that have an allocation for this worktree name.
# Used to find the project configuration once the worktree directory is gone.
allocation_projects_for_worktree() {
  local wt_name="$1"
  local alloc
  alloc="$(allocations_file)"
  [ -f "$alloc" ] || return 0

  awk -F'\t' -v w="$wt_name" '$2 == w {print $1}' "$alloc" | sort -u
}

# Load the project configuration (including the main checkout's
# .worktree.local.toml) from a main checkout, starting from a clean slate.
load_main_configuration() {
  local main_path="$1"
  [ -d "$main_path" ] || return 1
  toml_reset
  load_project_configuration "$main_path"
}

# Print the main checkouts that have a record or an allocation for a worktree.
# Used to find the project configuration once the worktree directory is gone.
cleanup_projects_for_worktree() {
  local worktree_path="$1"
  local wt_name="$2"

  local recorded_projects
  recorded_projects="$(recorded_lines "$worktree_path" | cut -f1 | sort -u)"
  # A record names the project of its worktree; the allocations, which only
  # know a folder name, are for worktrees that have none.
  if [ -n "$recorded_projects" ]; then
    printf '%s\n' "$recorded_projects"
  else
    allocation_projects_for_worktree "$wt_name" | sort -u
  fi
}

# Returns 0 when the project has an existing worktree named $2 besides the one
# at path $3, 1 when it has none, and 2 when its worktrees cannot be listed.
project_has_worktree_named() {
  local project="$1"
  local wt_name="$2"
  local excluded="$3"
  local listing wt_line wt_path

  [ -d "$project" ] || return 1
  if ! (cd "$project" && is_git_repo); then
    [ -e "${project}/.git" ] && return 2
    return 1
  fi
  listing="$(cd "$project" && git worktree list --porcelain 2>/dev/null)" || return 2

  while IFS= read -r wt_line; do
    case "$wt_line" in
      "worktree "*) wt_path="${wt_line#worktree }" ;;
      *) continue ;;
    esac
    [ "$wt_path" = "$excluded" ] && continue
    [ -d "$wt_path" ] || continue
    if [ "$(basename "$wt_path")" = "$wt_name" ]; then
      return 0
    fi
  done <<EOF_LISTING
$listing
EOF_LISTING
  return 1
}

# Release the port/redis allocation of a worktree name in one project, unless
# another worktree of that project still has that name (allocations are keyed
# by project and name, so that one would lose its ports).
release_worktree_allocation() {
  local project="$1"
  local wt_name="$2"
  local worktree_path="$3"
  local status=0

  project_has_worktree_named "$project" "$wt_name" "$worktree_path" || status=$?
  case "$status" in
    0) log_info "Keeping the port/redis allocation for $wt_name in $project: another worktree has that name" ;;
    2) log_warn "Cannot read the worktrees of $project, keeping its port/redis allocation for $wt_name" ;;
    *)
      deregister_allocation "$wt_name" "$project"
      log_info "Released port/redis allocation"
      ;;
  esac
}

# Drop the databases of one worktree, going by the record. The connection
# settings must be loaded already; $3 is the main checkout they came from.
#
# - With a record: exactly the recorded databases, then the record goes.
# - Without one, folder still there: the two names of 0.3.1 and earlier.
# - Without one, folder gone: the databases whose name ends in the worktree
#   name, but only those no existing worktree of any registered project uses
#   and no record names. A name alone says nothing about which repo it is from.
#
# A database that another existing worktree also uses is never dropped. When
# that cannot be told, nothing is dropped and `werksfeer --prune` is named.
cleanup_worktree_databases() {
  local worktree_path="$1"
  local wt_name="$2"
  local project="${3:-}"

  if ! has_psql; then
    log_warn "psql not found, skipping database cleanup"
    return 0
  fi

  if ! shared_pg_reachable; then
    log_warn "Skipping database cleanup"
    return 0
  fi

  wt_name="$(sanitize_name "$wt_name")"

  # A worktree that still exists is found by its path alone; once it is gone
  # the record is read for the project whose configuration is loaded.
  local record_project="$project"
  [ -d "$worktree_path" ] && record_project=""

  local recorded candidates="" from_record=false
  recorded="$(recorded_lines "$worktree_path" "$record_project")"
  if [ -n "$recorded" ]; then
    from_record=true
    candidates="$(printf '%s\n' "$recorded" | cut -f4)"
  else
    local wt_branch=""
    if [ -d "$worktree_path" ]; then
      wt_branch="$(cd "$worktree_path" 2>/dev/null && sanitize_name "$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo HEAD)")" || wt_branch=""
    fi

    if [ -n "$wt_branch" ]; then
      # On a server shared with other machines an old name may be another
      # machine's database: only the worktree's own environment can vouch.
      if ! shared_server_is_remote || env_names_database "$worktree_path" DATABASE_NAME "worktree_${wt_branch}_${wt_name}"; then
        candidates="$(pg_identifier "worktree_${wt_branch}_${wt_name}")
"
      fi
      if ! shared_server_is_remote || env_names_database "$worktree_path" TEST_DATABASE_NAME "worktree_${wt_branch}_${wt_name}_test"; then
        candidates="${candidates}$(pg_identifier "worktree_${wt_branch}_${wt_name}_test")
"
      fi
    elif shared_server_is_remote; then
      log_warn "Not dropping databases of $wt_name: it has no record on this machine and the server $(shared_server_host) may be used by other machines"
    elif [ -n "$wt_name" ]; then
      log_debug "No record and the worktree directory is gone, looking for databases ending with _${wt_name}"
      local all_wt_dbs recorded_dbs db
      if ! all_wt_dbs="$(list_server_databases)"; then
        log_warn "Cannot list the databases on the PostgreSQL server, skipping database cleanup"
        return 0
      fi
      all_wt_dbs="$(printf '%s\n' "$all_wt_dbs" | grep '^worktree_' || true)"
      recorded_dbs=""
      [ -f "$(databases_file)" ] && recorded_dbs="$(cut -f4 "$(databases_file)")"
      while IFS= read -r db; do
        [ -n "$db" ] || continue
        # The record names the databases of its own worktrees.
        if printf '%s\n' "$recorded_dbs" | grep -qxF "$db"; then
          continue
        fi
        if printf '%s\n' "$db" | grep -qE "_${wt_name}(_test)?$"; then
          candidates="${candidates}${db}
"
        fi
      done <<EOF_ALL
$all_wt_dbs
EOF_ALL
    fi
  fi

  [ -n "$candidates" ] || return 0

  if [ -z "$project" ] && [ ! -d "$worktree_path" ] && is_git_repo; then
    project="$(get_main_worktree_path)"
  fi

  if [ -z "$project" ] && [ -z "$(registered_project_list)" ]; then
    log_warn "Not dropping the databases of $wt_name: werksfeer does not know which project it belonged to"
    log_warn "Run werksfeer --prune to remove them once they are orphaned"
    return 0
  fi

  local claimed
  if ! claimed="$(claimed_databases "$worktree_path" "${project}
$(registered_project_list)")"; then
    log_warn "Not dropping the databases of $wt_name: without the worktrees of that project werksfeer cannot tell whether another worktree uses them"
    log_warn "Run werksfeer --prune to remove them once they are orphaned"
    return 0
  fi

  local db failed=false
  while IFS= read -r db; do
    [ -n "$db" ] || continue
    if printf '%s\n' "$claimed" | grep -qxF "$(pg_identifier "$db")"; then
      log_info "Keeping $db: another worktree uses it"
    else
      local exists=0
      db_exists "$db" || exists=$?
      case "$exists" in
        0)
          log_info "Dropping $db"
          if ! shared_pg dropdb --if-exists "$db" 2>/dev/null; then
            log_warn "Failed to drop $db"
            failed=true
          fi
          ;;
        1) ;;
        *)
          # Could not ask is not the same as gone: keep the record.
          log_warn "Cannot tell whether $db exists"
          failed=true
          ;;
      esac
    fi
  done <<EOF_CANDIDATES
$candidates
EOF_CANDIDATES

  # Keep the record while a database is left, so --prune can try again.
  if [ "$from_record" = true ]; then
    if [ "$failed" = false ]; then
      forget_worktree_databases "$worktree_path" "$record_project"
    else
      log_warn "Keeping the record of $worktree_path; werksfeer --prune will try again"
    fi
  fi
  return 0
}

cleanup_worktree() {
  local worktree_path
  worktree_path="$(normalize_path "$1")"
  local wt_name
  wt_name="$(basename "$worktree_path")"

  log_step "Cleaning up worktree: $wt_name"

  local project_root=""
  local main_path=""
  local private_postgres=false
  local configured=false
  if [ -d "$worktree_path" ] && (cd "$worktree_path" && is_git_repo); then
    project_root="$(cd "$worktree_path" && current_project_root)"
    main_path="$(cd "$project_root" && get_main_worktree_path)"

    if load_project_configuration "$project_root"; then
      configured=true
      if use_private_postgres_cluster; then
        private_postgres=true
      fi
      run_services_action "cleanup" "$project_root"
    fi
  fi

  # The worktree is gone (or no longer a git repo): the record and the
  # allocation still name the main checkout, which holds the configuration and
  # the local settings (such as the database password). Look it up before
  # releasing anything.
  local lookup_mains=""
  if [ -n "$main_path" ]; then
    release_worktree_allocation "$main_path" "$wt_name" "$worktree_path"
  else
    lookup_mains="$(cleanup_projects_for_worktree "$worktree_path" "$wt_name")"
    # Nothing known: fall back to the checkout the command runs from.
    if [ -z "$lookup_mains" ] && is_git_repo; then
      lookup_mains="$(get_main_worktree_path)"
    fi

    # Only the projects that had this worktree release its allocation, and
    # only when they have no existing worktree of that name left.
    local lookup_main
    while IFS= read -r lookup_main; do
      [ -n "$lookup_main" ] || continue
      release_worktree_allocation "$lookup_main" "$wt_name" "$worktree_path"
    done <<EOF_RELEASE
$lookup_mains
EOF_RELEASE
  fi

  if [ "$private_postgres" = true ]; then
    return 0
  fi

  # A record names the project of its databases; the allocations are only a
  # hint for worktrees that have none.
  local database_mains
  database_mains="$(recorded_lines "$worktree_path" | cut -f1 | sort -u)"
  [ -n "$database_mains" ] || database_mains="$lookup_mains"

  if [ "$configured" = true ] || [ -z "$database_mains" ]; then
    cleanup_worktree_databases "$worktree_path" "$wt_name" "$main_path"
    return 0
  fi

  while IFS= read -r lookup_main; do
    [ -z "$lookup_main" ] && continue
    if load_main_configuration "$lookup_main"; then
      log_debug "Loaded configuration from $lookup_main"
      if use_private_postgres_cluster; then
        continue
      fi
    fi
    cleanup_worktree_databases "$worktree_path" "$wt_name" "$lookup_main"
  done <<EOF_MAINS
$database_mains
EOF_MAINS
}

# ---------------------------------------------------------------------------
# Prune
# ---------------------------------------------------------------------------

prune_project() {
  local project_dir="${1:-.}"

  if ! (cd "$project_dir" && is_git_repo); then
    log_warn "$project_dir is not a git repo, skipping"
    return 0
  fi

  # Prune stale allocations: remove entries for worktrees that no longer exist
  local alloc
  alloc="$(allocations_file)"
  if [ -f "$alloc" ]; then
    # Paths come from the porcelain output, so a path with spaces stays whole.
    # When the list cannot be read, no allocation is released: an empty list
    # would make every worktree of the project look gone.
    local listing active_wt_names="" wt_line
    if listing="$(cd "$project_dir" && git worktree list --porcelain 2>/dev/null)"; then
      while IFS= read -r wt_line; do
        case "$wt_line" in
          "worktree "*) active_wt_names="${active_wt_names}$(basename "${wt_line#worktree }")
" ;;
        esac
      done <<EOF_ACTIVE
$listing
EOF_ACTIVE

      state_lock_acquire || return 1
      local tmp="${alloc}.tmp"
      while IFS="$(printf '\t')" read -r a_project a_wt a_port a_redis; do
        if [ "$a_project" = "$project_dir" ] && ! echo "$active_wt_names" | grep -qxF "$a_wt"; then
          log_info "Released allocation: port=$a_port redis_db=$a_redis (worktree: $a_wt)"
        else
          printf '%s\t%s\t%s\t%s\n' "$a_project" "$a_wt" "$a_port" "$a_redis"
        fi
      done < "$alloc" > "$tmp"
      mv "$tmp" "$alloc"
      state_lock_release
    else
      log_warn "Cannot read the worktrees of $project_dir, keeping its port/redis allocations"
    fi
  fi

  if ! has_psql; then
    log_warn "psql not found, skipping database prune"
    return 0
  fi

  # Connection settings live in the project's configuration, which is not
  # loaded yet when pruning from outside a setup run (and differs per project
  # for --prune-all).
  load_main_configuration "$project_dir" || log_debug "No configuration loaded for $project_dir"

  if ! shared_pg_reachable; then
    log_warn "Skipping database prune"
    return 0
  fi

  # Get all worktree_* databases
  local all_wt_dbs
  if ! all_wt_dbs="$(list_server_databases)"; then
    log_warn "Cannot list the databases on the PostgreSQL server"
    log_warn "Skipping database prune"
    return 0
  fi
  all_wt_dbs="$(printf '%s\n' "$all_wt_dbs" | grep '^worktree_' || true)"

  if [ -z "$all_wt_dbs" ]; then
    log_info "No worktree databases found"
    prune_database_records "$project_dir" ""
    return 0
  fi

  # A database is orphaned only when no registered project owns it: projects
  # can share one PostgreSQL server (or one local server), so the worktrees of
  # this project alone do not tell which databases are safe to drop. Without
  # the registry we cannot tell, so we drop nothing.
  local reg
  reg="$(registry_file)"
  if [ ! -f "$reg" ] || [ ! -r "$reg" ]; then
    log_warn "No project registry found at $reg"
    log_warn "Other projects may use databases on this server, and without the registry werksfeer cannot tell which ones. Run werksfeer in each project to register it."
    log_warn "Skipping database prune"
    return 0
  fi

  # The current project may not be registered yet; registered projects whose
  # directory is gone contribute nothing.
  # Recorded databases of a worktree that still exists are active too.
  local active_dbs
  if ! active_dbs="$(claimed_databases "" "${project_dir}
$(registered_project_list)")"; then
    log_warn "Skipping database prune: without them werksfeer cannot tell which databases are active"
    return 0
  fi
  active_dbs="${active_dbs}
"

  # On a server another machine may use, only databases this machine recorded
  # for a worktree of this project that is gone can be dropped: a database
  # without a record here may belong to a worktree on another machine.
  local drop_candidates="$all_wt_dbs"
  if shared_server_is_remote; then
    drop_candidates="$(recorded_gone_databases "$project_dir" "$all_wt_dbs")"
    local unrecorded
    unrecorded="$(unrecorded_databases "$all_wt_dbs")"
    if [ -n "$unrecorded" ]; then
      log_info "$(printf '%s\n' "$unrecorded" | wc -l | tr -d ' ') worktree databases on $(shared_server_host) have no record on this machine and were left: another machine may use them"
    fi
  fi

  printf '%s\n' "$drop_candidates" | while IFS= read -r db; do
    [ -z "$db" ] && continue

    local found=false
    while IFS= read -r active_db; do
      [ -z "$active_db" ] && continue
      if [ "$db" = "$active_db" ]; then
        found=true
        break
      fi
    done <<EOF
$active_dbs
EOF

    if [ "$found" = false ]; then
      log_info "Dropping orphaned database: $db"
      shared_pg dropdb --if-exists "$db" 2>/dev/null || log_warn "Failed to drop $db"
    else
      log_debug "Keeping active database: $db"
    fi
  done

  prune_database_records "$project_dir" "$active_dbs"
}

# Print the databases of $2 (one per line) that the record names for a worktree
# of project $1 whose folder is gone.
recorded_gone_databases() {
  local project_dir="$1"
  local listed="$2"
  local file r_project r_path r_role r_db

  file="$(databases_file)"
  [ -f "$file" ] || return 0
  while IFS="$TAB" read -r r_project r_path r_role r_db || [ -n "$r_db" ]; do
    [ -n "$r_db" ] || continue
    [ "$r_project" = "$project_dir" ] || continue
    [ ! -d "$r_path" ] || continue
    if printf '%s\n' "$listed" | grep -qxF "$(pg_identifier "$r_db")"; then
      pg_identifier "$r_db"
      echo
    fi
  done < "$file"
  return 0
}

# Print the databases of $1 (one per line) that no record line names.
unrecorded_databases() {
  local listed="$1"
  local file recorded db

  file="$(databases_file)"
  recorded=""
  [ -f "$file" ] && recorded="$(cut -f4 "$file")"
  while IFS= read -r db; do
    [ -n "$db" ] || continue
    if ! printf '%s\n' "$recorded" | grep -qxF "$db"; then
      printf '%s\n' "$db"
    fi
  done <<EOF_LISTED
$listed
EOF_LISTED
  return 0
}

# Forget the recorded databases of this project's worktrees that are gone,
# once their databases are gone from the server (dropped, or kept because
# another existing worktree claims them). A database that is still there and
# unclaimed keeps its record so the next prune tries again.
prune_database_records() {
  local project_dir="$1"
  local active_dbs="$2"
  local file tmp server_dbs r_project r_path r_role r_db keep

  file="$(databases_file)"
  [ -f "$file" ] || return 0

  if ! server_dbs="$(list_server_databases)"; then
    log_warn "Cannot list the databases, keeping the database record"
    return 0
  fi

  state_lock_acquire || return 1
  tmp="${file}.tmp.$$"
  : > "$tmp"
  while IFS="$TAB" read -r r_project r_path r_role r_db || [ -n "$r_db" ]; do
    [ -n "$r_db" ] || continue
    keep=true
    if [ "$r_project" = "$project_dir" ] && [ ! -d "$r_path" ]; then
      if ! printf '%s\n' "$server_dbs" | grep -qxF "$(pg_identifier "$r_db")" ||
          printf '%s\n' "$active_dbs" | grep -qxF "$(pg_identifier "$r_db")"; then
        keep=false
        log_debug "Forgetting $r_db (worktree: $r_path)"
      fi
    fi
    if [ "$keep" = true ]; then
      printf '%s\t%s\t%s\t%s\n' "$r_project" "$r_path" "$r_role" "$r_db" >> "$tmp"
    fi
  done < "$file"
  mv "$tmp" "$file"
  state_lock_release
}

prune_current() {
  if ! is_git_repo; then
    log_error "Not in a git repository"
    return 1
  fi
  local main_path
  main_path="$(get_main_worktree_path)"
  log_step "Pruning orphaned databases for: $(basename "$main_path")"
  prune_project "$main_path"
}

prune_all() {
  local reg
  reg="$(registry_file)"

  if [ ! -f "$reg" ]; then
    log_warn "No projects registered yet. Run werksfeer in a project first."
    return 0
  fi

  while IFS= read -r project_path; do
    [ -z "$project_path" ] && continue
    if [ ! -d "$project_path" ]; then
      log_warn "Skipping $project_path (directory not found)"
      continue
    fi
    log_step "Pruning databases for: $(basename "$project_path")"
    prune_project "$project_path"
  done < "$reg"
}

# ---------------------------------------------------------------------------
# Core setup flow
# ---------------------------------------------------------------------------

run_setup() {
  local main_path
  main_path="$(get_main_worktree_path)"
  local worktree_path
  worktree_path="$(pwd)"

  log_step "werksfeer v${WERKSFEER_VERSION} - Setting up worktree"
  log_info "Main:     $main_path"
  log_info "Worktree: $worktree_path"

  load_project_configuration "$worktree_path"

  # Detect project type
  local project_type
  project_type="$(detect_project_type "$main_path")"
  log_info "Project type: $project_type"

  if managed_cache_auto_warm_enabled; then
    if ! managed_cache_warm "$worktree_path"; then
      log_warn "Managed build cache warming failed; continuing with available local caches"
    fi
  else
    local auto_warm_status=$?
    [ "$auto_warm_status" -eq 1 ] || return "$auto_warm_status"
  fi

  local build_cache_source="$main_path"
  local managed_source=""
  managed_source="$(managed_cache_source "$main_path" "$worktree_path")" || managed_source=""
  if [ -n "$managed_source" ]; then
    build_cache_source="$managed_source"
    log_info "Using managed build cache: $managed_source"
  fi

  # Register for prune-all
  register_project

  # Step 1: Copy env files
  log_step "Copying environment files"
  sync_env_files "$main_path" "$worktree_path" "$project_type"
  # Harnesses may still launch an agent to diagnose a later setup failure.
  # Approve a copied .envrc now, then approve its managed rewrite below too.
  allow_project_environment

  # Step 2: Restore shared directories (node_modules). Managed caches are
  # copied so a feature worktree can never mutate the authoritative cache.
  log_step "Restoring shared directories"
  if [ -n "$managed_source" ]; then
    sync_managed_shared_dirs "$build_cache_source" "$worktree_path" "$project_type"
  else
    sync_symlink_dirs "$main_path" "$worktree_path" "$project_type"
  fi

  # Step 3: Copy build directories
  log_step "Copying build directories"
  copy_build_dirs "$build_cache_source" "$worktree_path" "$project_type"

  # Step 4: Provision databases/services
  log_step "Setting up databases"
  setup_databases "$project_type" "$worktree_path"

  # Step 5: Write environment overrides (DB names, ports, Redis)
  log_step "Writing environment overrides"
  write_env_overrides "$project_type" "$worktree_path"

  # Step 6: Run setup command
  log_step "Running setup"
  run_setup_command "$project_type" "$worktree_path"

  # Publish only a cleanly stopped, fully prepared database whose HEAD exactly
  # matches the configured remote template ref. Feature-branch state is never
  # shared with unrelated worktrees.
  if use_private_postgres_cluster; then
    if ! run_service_action "postgres" "template_publish" "$worktree_path" "$project_type"; then
      log_warn "PostgreSQL template publication failed; the worktree database remains usable"
    fi
  fi

  # Step 7: Post-setup hook from config
  local post_hook
  post_hook="$(toml_get "hooks" "post_setup" "")"
  if [ -n "$post_hook" ]; then
    log_step "Running post-setup hook"
    run_shell_in_project_environment "$post_hook"
  fi

  log_step "Worktree setup complete!"
}

# ---------------------------------------------------------------------------
# Usage
# ---------------------------------------------------------------------------

usage() {
  cat >&2 <<'EOF_USAGE'
werksfeer - Universal git worktree setup

Usage:
  werksfeer                  Setup the current worktree (run from inside a worktree)
  werksfeer --hook ...       Called from post-checkout git hook
  werksfeer services COMMAND Manage configured worktree services
  werksfeer postgres COMMAND Manage the PostgreSQL service directly
  werksfeer exec COMMAND...  Run a command through the worktree's project environment
  werksfeer cache warm      Refresh the managed dependency/build cache
  werksfeer cache status    Inspect the managed dependency/build cache
  werksfeer cache clean     Remove the managed dependency/build cache
  werksfeer --cleanup [PATH] Stop services and clean a worktree (defaults to current directory)
  werksfeer --prune          Drop orphaned worktree databases for current project
  werksfeer --prune-all      Drop orphaned worktree databases for all registered projects
  werksfeer --version        Print version
  werksfeer --help           Print this help

Environment:
  WERKSFEER_DEBUG=1         Enable debug logging
  WERKSFEER_POSTGRES=false Disable private PostgreSQL for this shell
  WERKSFEER_CACHE_AUTO_WARM=true|false Override automatic cache warming
  WERKSFEER_CACHE_RETENTION_DAYS=N Override unused-cache retention (0 disables)
  WERKSFEER_LIB_DIR=PATH    Override the service module directory

Werksfeer reads .worktree.toml, then overlays ignored .worktree.local.toml
files from the main checkout and current worktree when present.
See https://github.com/DefactoSoftware/werksfeer for details.
EOF_USAGE
}

# ---------------------------------------------------------------------------
# Entry points
# ---------------------------------------------------------------------------

hook_mode() {
  local prev_head="${1:-}"
  local new_head="${2:-}"
  local flag="${3:-}"

  if ! is_worktree_creation "$prev_head" "$new_head" "$flag"; then
    log_debug "Not a worktree creation, skipping"
    return 0
  fi

  # Only activate when .worktree.toml exists
  local main_path
  main_path="$(get_main_worktree_path)"
  if [ ! -f "$main_path/.worktree.toml" ] && [ ! -f ".worktree.toml" ]; then
    log_debug "No .worktree.toml found, skipping"
    return 0
  fi

  run_setup
}

direct_mode() {
  if ! is_git_repo; then
    log_error "Not inside a git repository"
    return 1
  fi

  if ! is_worktree; then
    log_error "Not inside a worktree (this is the main checkout)"
    log_info "Run this from inside a worktree created with: wt switch -c <branch>"
    return 1
  fi

  local main_path
  main_path="$(get_main_worktree_path)"
  if [ ! -f "$main_path/.worktree.toml" ] && [ ! -f ".worktree.toml" ]; then
    log_error "No .worktree.toml found in $main_path"
    log_info "Create one to configure werksfeer. See: werksfeer --help"
    return 1
  fi

  run_setup
}

service_mode() {
  local command="$1"
  shift
  local action="${1:-}"
  [ "$#" -gt 0 ] && shift

  if ! is_git_repo; then
    log_error "Not inside a git repository"
    return 1
  fi

  local project_root
  project_root="$(current_project_root)"
  load_project_configuration "$project_root"

  if [ "$command" = "services" ]; then
    services_cli "$action" "$project_root"
  else
    service_provider_cli "$command" "$action" "$project_root" "$@"
  fi
}

exec_mode() {
  shift
  if [ "$#" -eq 0 ]; then
    log_error "exec requires a command"
    return 1
  fi

  if ! is_git_repo; then
    log_error "Not inside a git repository"
    return 1
  fi

  local project_root
  project_root="$(current_project_root)"
  load_project_configuration "$project_root"
  run_services_action "start" "$project_root"
  run_in_project_environment "$@"
}

cache_mode() {
  shift
  local action="${1:-status}"

  if ! is_git_repo; then
    log_error "Not inside a git repository"
    return 1
  fi

  local project_root
  project_root="$(current_project_root)"
  load_project_configuration "$project_root"

  case "$action" in
    warm) managed_cache_warm "$project_root" ;;
    status) managed_cache_status "$project_root" ;;
    clean) managed_cache_clean "$project_root" ;;
    *)
      log_error "Unknown cache command: $action"
      log_info "Available commands: warm, status, clean"
      return 2
      ;;
  esac
}

main() {
  case "${1:-}" in
    --mise-exec)
      shift
      run_with_mise "$@"
      ;;
    --asdf-exec)
      shift
      run_with_asdf "$@"
      ;;
    --hook)
      shift
      hook_mode "$@"
      ;;
    --cleanup)
      shift
      cleanup_worktree "${1:-$(pwd)}"
      ;;
    --prune)
      prune_current
      ;;
    --prune-all)
      prune_all
      ;;
    services)
      service_mode "$@"
      ;;
    postgres)
      service_mode "$@"
      ;;
    exec)
      exec_mode "$@"
      ;;
    cache)
      cache_mode "$@"
      ;;
    --version|-V)
      echo "werksfeer $WERKSFEER_VERSION"
      ;;
    --help|-h)
      usage
      ;;
    *)
      direct_mode
      ;;
  esac
}

load_werksfeer_modules
main "$@"
