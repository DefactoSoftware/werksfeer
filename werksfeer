#!/usr/bin/env bash
# shellcheck disable=SC2001 # sed expressions below use regular expressions intentionally.
# werksfeer - Universal git worktree setup tool
# https://github.com/DefactoSoftware/werksfeer
#
# Compatible with bash 3.2+ (macOS default), bash 5.x, and called from zsh/fish.
# Requires: git, optionally PostgreSQL tools for database cloning/services.

set -euo pipefail

WERKSFEER_VERSION="0.3.0"

WERKSFEER_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

log_info()  { echo "[werksfeer] $*" >&2; }
log_warn()  { echo "[werksfeer] WARNING: $*" >&2; }
log_error() { echo "[werksfeer] ERROR: $*" >&2; }
log_debug() { [ "${WERKSFEER_DEBUG:-0}" = "1" ] && echo "[werksfeer] DEBUG: $*" >&2 || true; }
log_step()  { echo "[werksfeer] ==> $*" >&2; }

load_werksfeer_modules() {
  local lib_dir="${WERKSFEER_LIB_DIR:-}"

  if [ -z "$lib_dir" ] && [ -f "${WERKSFEER_SCRIPT_DIR}/lib/werksfeer/services.sh" ]; then
    lib_dir="${WERKSFEER_SCRIPT_DIR}/lib/werksfeer"
  fi

  if [ -z "$lib_dir" ]; then
    lib_dir="${XDG_DATA_HOME:-$HOME/.local/share}/werksfeer/lib"
  fi

  if [ ! -f "${lib_dir}/services.sh" ] ||
      [ ! -f "${lib_dir}/services/postgres.sh" ] ||
      [ ! -f "${lib_dir}/cache.sh" ]; then
    log_error "Werksfeer modules were not found in $lib_dir"
    log_info "Reinstall werksfeer with install.sh or set WERKSFEER_LIB_DIR"
    return 1
  fi

  # shellcheck source=/dev/null
  source "${lib_dir}/services.sh"
  # shellcheck source=/dev/null
  source "${lib_dir}/services/postgres.sh"
  # shellcheck source=/dev/null
  source "${lib_dir}/cache.sh"
}

# ---------------------------------------------------------------------------
# Minimal TOML parser
# ---------------------------------------------------------------------------
# Handles [section], key = "value", key = ["a", "b"], key = true/false/int.
# Stores values in _TOML_<SECTION>_<KEY> variables.
# Arrays are stored as newline-delimited strings.

_TOML_PARSED=0

toml_parse() {
  local file="$1"
  [ ! -f "$file" ] && return 0
  _TOML_PARSED=1

  local section=""
  while IFS= read -r line || [ -n "$line" ]; do
    # Strip inline comments (only outside quotes — simplified: strip # not inside quotes)
    line="$(echo "$line" | sed 's/[[:space:]]*#[^"]*$//')"
    # Trim whitespace
    line="$(echo "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
    [ -z "$line" ] && continue

    # Section header
    if echo "$line" | grep -qE '^\[[a-zA-Z_][a-zA-Z0-9_]*\]$'; then
      section="$(echo "$line" | sed 's/^\[\(.*\)\]$/\1/' | tr '[:lower:]' '[:upper:]')"
      continue
    fi

    # Key = value
    local key value
    key="$(echo "$line" | sed 's/[[:space:]]*=.*//' | tr '[:lower:]' '[:upper:]' | sed 's/[^A-Z0-9_]/_/g')"
    value="$(echo "$line" | sed 's/^[^=]*=[[:space:]]*//')"

    [ -z "$key" ] && continue
    [ -z "$section" ] && section="DEFAULT"

    # Array value: ["a", "b", "c"]
    if echo "$value" | grep -qE '^\['; then
      # Strip brackets, quotes, split on comma
      value="$(echo "$value" | sed 's/^\[//;s/\]$//;s/"//g;s/'\''//g' | tr ',' '\n' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | grep -v '^$')"
    else
      # Strip surrounding quotes from scalar
      value="$(echo "$value" | sed 's/^"//;s/"$//;s/^'\''//;s/'\''$//')"
    fi

    local varname="_TOML_${section}_${key}"
    eval "${varname}=\$(cat <<'_TOML_EOF_'
${value}
_TOML_EOF_
)"
  done < "$file"
}

toml_get() {
  local section key default varname
  section="$(echo "$1" | tr '[:lower:]' '[:upper:]')"
  key="$(echo "$2" | tr '[:lower:]' '[:upper:]' | sed 's/[^A-Z0-9_]/_/g')"
  default="${3:-}"
  varname="_TOML_${section}_${key}"
  eval "echo \"\${${varname}:-${default}}\""
}

toml_get_array() {
  local section key varname
  section="$(echo "$1" | tr '[:lower:]' '[:upper:]')"
  key="$(echo "$2" | tr '[:lower:]' '[:upper:]' | sed 's/[^A-Z0-9_]/_/g')"
  varname="_TOML_${section}_${key}"
  eval "echo \"\${${varname}:-}\""
}

toml_reset() {
  local variable_name
  while IFS= read -r variable_name; do
    unset "$variable_name"
  done < <(compgen -A variable _TOML_)
  _TOML_PARSED=0
}

# ---------------------------------------------------------------------------
# Git helpers
# ---------------------------------------------------------------------------

is_git_repo() {
  git rev-parse --git-dir >/dev/null 2>&1
}

is_worktree() {
  # In a worktree .git is a FILE (contains "gitdir: ..."), not a directory
  [ -f ".git" ]
}

get_main_worktree_path() {
  git worktree list --porcelain | head -1 | sed 's/^worktree //'
}

get_worktree_name() {
  basename "$(pwd)"
}

get_worktree_branch() {
  git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "HEAD"
}

get_project_name() {
  basename "$(get_main_worktree_path)" | tr '[:upper:]' '[:lower:]'
}

sanitize_name() {
  echo "$1" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9_]/_/g' | sed 's/__*/_/g' | sed 's/^_//;s/_$//'
}

# ---------------------------------------------------------------------------
# Port / Redis allocation registry
# ---------------------------------------------------------------------------
# File: ~/.local/share/werksfeer/allocations
# Format: project_path<TAB>worktree_name<TAB>port<TAB>redis_db

allocations_file() {
  echo "${XDG_DATA_HOME:-$HOME/.local/share}/werksfeer/allocations"
}

# Find the next available port starting from base+1, skipping any already in the registry.
allocate_port() {
  local base_port="$1"
  local alloc
  alloc="$(allocations_file)"
  local port=$(( base_port + 1 ))

  while true; do
    if [ ! -f "$alloc" ] || ! awk -F'\t' '{print $3}' "$alloc" | grep -qxF "$port"; then
      echo "$port"
      return
    fi
    port=$(( port + 1 ))
  done
}

# Find the next available Redis DB (1-15) for a given project, skipping any in use.
allocate_redis_db() {
  local project="$1"
  local alloc
  alloc="$(allocations_file)"
  local db=1

  while [ "$db" -le 15 ]; do
    if [ ! -f "$alloc" ] || ! awk -F'\t' -v p="$project" '$1 == p {print $4}' "$alloc" | grep -qxF "$db"; then
      echo "$db"
      return
    fi
    db=$(( db + 1 ))
  done

  # All 15 slots taken — fall back to 1
  log_warn "All 15 Redis databases in use for this project, reusing DB 1"
  echo 1
}

# Find the next available Redis port starting from base+1, skipping any already in the registry.
allocate_redis_port() {
  local base_port="$1"
  local alloc
  alloc="$(allocations_file)"
  local port=$(( base_port + 1 ))

  while true; do
    if [ ! -f "$alloc" ] || ! awk -F'\t' '{print $5}' "$alloc" | grep -qxF "$port"; then
      echo "$port"
      return
    fi
    port=$(( port + 1 ))
  done
}

# Register an allocation
register_allocation() {
  local project="$1"
  local wt_name="$2"
  local port="$3"
  local redis_db="$4"
  local redis_port="${5:-}"
  local alloc
  alloc="$(allocations_file)"

  mkdir -p "$(dirname "$alloc")"
  printf '%s\t%s\t%s\t%s\t%s\n' "$project" "$wt_name" "$port" "$redis_db" "$redis_port" >> "$alloc"
}

# Remove an allocation by worktree name (and optionally project)
deregister_allocation() {
  local wt_name="$1"
  local project="${2:-}"
  local alloc
  alloc="$(allocations_file)"
  [ ! -f "$alloc" ] && return 0

  local tmp="${alloc}.tmp"
  if [ -n "$project" ]; then
    awk -F'\t' -v p="$project" -v w="$wt_name" '!($1 == p && $2 == w)' "$alloc" > "$tmp"
  else
    awk -F'\t' -v w="$wt_name" '$2 != w' "$alloc" > "$tmp"
  fi
  mv "$tmp" "$alloc"
}

# Look up existing allocation for a worktree. Prints "port<TAB>redis_db<TAB>redis_port" or empty.
lookup_allocation() {
  local project="$1"
  local wt_name="$2"
  local alloc
  alloc="$(allocations_file)"
  [ ! -f "$alloc" ] && return 0

  awk -F'\t' -v p="$project" -v w="$wt_name" '$1 == p && $2 == w {printf "%s\t%s\t%s", $3, $4, $5}' "$alloc"
}

is_worktree_creation() {
  local prev_head="${1:-}"
  local new_head="${2:-}"
  local flag="${3:-}"
  local null_ref="0000000000000000000000000000000000000000"

  # Must be a branch checkout (flag=1), from the null ref, and .git is a file
  [ "$flag" = "1" ] && [ "$prev_head" = "$null_ref" ] && [ -f ".git" ]
}

# ---------------------------------------------------------------------------
# Project detection
# ---------------------------------------------------------------------------

detect_project_type() {
  local root="$1"

  if [ -f "$root/Gemfile" ] && [ -f "$root/config/database.yml" ]; then
    echo "rails"; return
  fi
  if [ -f "$root/mix.exs" ]; then
    echo "elixir"; return
  fi
  if [ -f "$root/pyproject.toml" ] || [ -f "$root/requirements.txt" ] || [ -f "$root/Pipfile" ]; then
    echo "python"; return
  fi
  if [ -f "$root/package.json" ]; then
    echo "node"; return
  fi
  echo "unknown"
}

load_project_configuration() {
  local project_root main_path project_config main_local_config worktree_local_config
  project_root="$(cd "$1" && pwd -P)"
  main_path="$(cd "$project_root" && get_main_worktree_path)"

  if [ -f "$project_root/.worktree.toml" ]; then
    project_config="$project_root/.worktree.toml"
  elif [ -f "$main_path/.worktree.toml" ]; then
    project_config="$main_path/.worktree.toml"
  else
    log_error "No .worktree.toml found for $project_root"
    return 1
  fi

  toml_parse "$project_config"

  # Personal settings in the main checkout apply to all of its linked
  # worktrees. A worktree-local file can override those settings one last time.
  # Repositories should ignore this file so credentials and preferences remain
  # local and do not make an otherwise reusable cache source appear dirty.
  main_local_config="$main_path/.worktree.local.toml"
  if [ -f "$main_local_config" ]; then
    toml_parse "$main_local_config"
    log_debug "Loaded local configuration from $main_local_config"
  fi

  worktree_local_config="$project_root/.worktree.local.toml"
  if [ "$worktree_local_config" != "$main_local_config" ] && [ -f "$worktree_local_config" ]; then
    toml_parse "$worktree_local_config"
    log_debug "Loaded worktree-local configuration from $worktree_local_config"
  fi
}

current_project_root() {
  git rev-parse --show-toplevel 2>/dev/null
}

# ---------------------------------------------------------------------------
# Default directories to symlink per project type (large, identical across worktrees)
# ---------------------------------------------------------------------------

default_symlink_dirs() {
  case "$1" in
    rails|elixir|node)
      printf '%s\n' node_modules
      ;;
    *)
      # Python, unknown: nothing to symlink by default
      ;;
  esac
}

# Default directories to copy per project type (build artifacts, caches)
# ---------------------------------------------------------------------------

default_copy_dirs() {
  case "$1" in
    rails)
      printf '%s\n' .bundle tmp/cache
      ;;
    elixir)
      printf '%s\n' _build deps priv/static
      ;;
    python)
      printf '%s\n' .venv __pycache__ .mypy_cache .pytest_cache .ruff_cache
      ;;
    node)
      printf '%s\n' .next .nuxt .svelte-kit .turbo .parcel-cache
      ;;
    *)
      ;;
  esac
}

default_copy_files() {
  case "$1" in
    rails)
      printf '%s\n' .env .sample.env .tool-versions
      ;;
    elixir)
      printf '%s\n' .envrc .tool-versions
      ;;
    python)
      printf '%s\n' .env .tool-versions .python-version
      ;;
    node)
      printf '%s\n' .env .nvmrc .node-version .tool-versions
      ;;
    *)
      printf '%s\n' .env
      ;;
  esac
}

# ---------------------------------------------------------------------------
# File sync
# ---------------------------------------------------------------------------

sync_env_files() {
  local main_path="$1"
  local worktree_path="$2"
  local project_type="$3"

  local copy_files
  copy_files="$(toml_get_array "sync" "copy")"
  [ -z "$copy_files" ] && copy_files="$(default_copy_files "$project_type")"

  echo "$copy_files" | while IFS= read -r file; do
    [ -z "$file" ] && continue
    local src="$main_path/$file"
    local dst="$worktree_path/$file"

    if [ ! -f "$src" ]; then
      log_debug "Skip copy $file (not in main worktree)"
      continue
    fi
    if [ -f "$dst" ]; then
      log_info "Skip copy $file (already exists)"
      continue
    fi

    local parent
    parent="$(dirname "$dst")"
    [ ! -d "$parent" ] && mkdir -p "$parent"

    cp "$src" "$dst"
    log_info "Copied $file"
  done
}

sync_symlink_dirs() {
  local main_path="$1"
  local worktree_path="$2"
  local project_type="$3"

  local symlink_dirs
  symlink_dirs="$(toml_get_array "sync" "symlink")"
  [ -z "$symlink_dirs" ] && symlink_dirs="$(default_symlink_dirs "$project_type")"
  [ -z "$symlink_dirs" ] && return 0

  if ! reusable_worktree_cache "$main_path" "$worktree_path"; then
    log_info "Skip shared directories (main checkout is not an exact, clean cache source)"
    return 0
  fi

  local skip_dirs
  skip_dirs="$(toml_get_array "sync" "skip")"

  echo "$symlink_dirs" | while IFS= read -r dir; do
    [ -z "$dir" ] && continue

    # Check skip list
    if [ -n "$skip_dirs" ] && echo "$skip_dirs" | grep -qxF "$dir"; then
      log_info "Skip symlink $dir (in skip list)"
      continue
    fi

    local src="$main_path/$dir"
    local dst="$worktree_path/$dir"

    if [ -L "$dst" ]; then
      log_info "Skip symlink $dir (already linked)"
      continue
    fi
    if [ -d "$dst" ]; then
      log_warn "$dir exists as directory, not symlinking"
      continue
    fi
    if [ ! -d "$src" ]; then
      log_debug "Skip symlink $dir (not yet in main worktree)"
      continue
    fi

    local parent
    parent="$(dirname "$dst")"
    [ ! -d "$parent" ] && mkdir -p "$parent"

    ln -s "$src" "$dst"
    log_info "Symlinked $dir -> $src"
  done
}

git_checkout_is_clean() {
  [ -z "$(git -C "$1" status --porcelain --untracked-files=all 2>/dev/null)" ]
}

reusable_worktree_cache() {
  local main_path="$1"
  local worktree_path="$2"
  local main_revision worktree_revision

  main_revision="$(git -C "$main_path" rev-parse HEAD 2>/dev/null)" || return 1
  worktree_revision="$(git -C "$worktree_path" rev-parse HEAD 2>/dev/null)" || return 1

  [ "$main_revision" = "$worktree_revision" ] || return 1
  git_checkout_is_clean "$main_path" || return 1
  git_checkout_is_clean "$worktree_path" || return 1
}

reusable_build_cache() {
  local main_path="$1"
  local worktree_path="$2"
  local main_revision worktree_revision

  main_revision="$(git -C "$main_path" rev-parse HEAD 2>/dev/null)" || return 1
  worktree_revision="$(git -C "$worktree_path" rev-parse HEAD 2>/dev/null)" || return 1

  git_checkout_is_clean "$main_path" || return 1
  git_checkout_is_clean "$worktree_path" || return 1
  git -C "$worktree_path" merge-base "$main_revision" "$worktree_revision" >/dev/null || return 1

  # Compiled artifacts are not portable across runtime versions. Dependency
  # lockfiles may differ safely because each package manager validates them,
  # but a changed toolchain declaration makes the entire cache ineligible.
  git -C "$worktree_path" diff --quiet "$main_revision" "$worktree_revision" -- \
    .tool-versions \
    mise.toml \
    .mise.toml \
    mise.local.toml \
    .mise.local.toml \
    .ruby-version \
    .node-version \
    .nvmrc \
    .python-version || return 1
}

copy_tree() {
  local source="$1"
  local destination="$2"

  [ -d "$source" ] || return 1
  [ ! -e "$destination" ] || {
    log_error "Refusing to overwrite cache copy destination: $destination"
    return 1
  }

  mkdir -p "$(dirname "$destination")"

  if [ "$(uname -s)" = "Darwin" ]; then
    # clonefile-backed copies are copy-on-write on APFS.
    if cp -cR "$source" "$destination" 2>/dev/null; then
      return 0
    fi
  elif cp --reflink=auto -a "$source" "$destination" 2>/dev/null; then
    return 0
  fi

  [ ! -e "$destination" ] || {
    log_error "Copy-on-write cache copy left a partial destination: $destination"
    return 1
  }

  cp -Rp "$source" "$destination"
}

remove_relocated_cmake_state() {
  local deps_path="$1"
  [ -d "$deps_path" ] || return 0

  # CMakeCache.txt contains absolute paths from the source checkout. Keeping it
  # makes a later native dependency rebuild fail after the tree is relocated.
  find "$deps_path" -type f -name CMakeCache.txt -delete

  find "$deps_path" -type d -name CMakeFiles -prune | while IFS= read -r cmake_dir; do
    [ -z "$cmake_dir" ] && continue
    find "$cmake_dir" -depth -delete
  done
}

sync_tracked_file_times() {
  local main_path="$1"
  local worktree_path="$2"
  local main_revision worktree_revision

  main_revision="$(git -C "$main_path" rev-parse HEAD)"
  worktree_revision="$(git -C "$worktree_path" rev-parse HEAD)"

  # Mix compiler manifests record source mtimes. Mirror times only for tracked
  # files that Git says are identical between the cache source and target.
  # Changed and newly-added files retain their worktree times so Mix sees them
  # as stale. Use one Elixir VM instead of spawning `touch` once per file;
  # large Phoenix applications can contain thousands of tracked files.
  git -C "$main_path" ls-files -z |
    WERKSFEER_MTIME_SOURCE="$main_path" \
      WERKSFEER_MTIME_TARGET="$worktree_path" \
      WERKSFEER_MTIME_SOURCE_REVISION="$main_revision" \
      WERKSFEER_MTIME_TARGET_REVISION="$worktree_revision" \
      elixir -e '
        source = System.fetch_env!("WERKSFEER_MTIME_SOURCE")
        target = System.fetch_env!("WERKSFEER_MTIME_TARGET")
        source_revision = System.fetch_env!("WERKSFEER_MTIME_SOURCE_REVISION")
        target_revision = System.fetch_env!("WERKSFEER_MTIME_TARGET_REVISION")

        changed_files =
          case System.cmd(
                 "git",
                 [
                   "-C",
                   target,
                   "diff",
                   "--name-only",
                   "-z",
                   source_revision,
                   target_revision,
                   "--"
                 ]
               ) do
            {output, 0} ->
              output
              |> :binary.split(<<0>>, [:global])
              |> MapSet.new()

            {_output, _status} ->
              System.halt(1)
          end

        IO.binread(:stdio, :eof)
        |> :binary.split(<<0>>, [:global])
        |> Enum.each(fn
          "" ->
            :ok

          relative_path ->
            source_file = Path.join(source, relative_path)
            target_file = Path.join(target, relative_path)

            with false <- MapSet.member?(changed_files, relative_path),
                 {:ok, stat} <- File.stat(source_file, time: :posix),
                 true <- File.regular?(target_file) do
              File.touch!(target_file, stat.mtime)
            end
        end)
      '
}

refresh_relocated_elixir_cache() {
  local main_path="$1"
  local worktree_path="$2"
  local deps_path="$worktree_path/deps"

  remove_relocated_cmake_state "$deps_path"
  sync_tracked_file_times "$main_path" "$worktree_path"
}

copy_build_dirs() {
  local main_path="$1"
  local worktree_path="$2"
  local project_type="$3"

  local copy_dirs
  copy_dirs="$(toml_get_array "sync" "copy_dirs")"
  [ -z "$copy_dirs" ] && copy_dirs="$(default_copy_dirs "$project_type")"
  [ -z "$copy_dirs" ] && return 0

  if ! reusable_build_cache "$main_path" "$worktree_path"; then
    log_info "Skip build cache (main checkout is not a clean, toolchain-compatible related revision)"
    return 0
  fi

  local skip_dirs
  skip_dirs="$(toml_get_array "sync" "skip")"
  local copied_elixir_build=false

  while IFS= read -r dir; do
    [ -z "$dir" ] && continue

    # Check skip list
    if [ -n "$skip_dirs" ] && echo "$skip_dirs" | grep -qxF "$dir"; then
      log_info "Skip copy $dir (in skip list)"
      continue
    fi

    local src="$main_path/$dir"
    local dst="$worktree_path/$dir"

    if [ -L "$dst" ] || [ -d "$dst" ]; then
      log_info "Skip copy $dir (already exists)"
      continue
    fi
    if [ ! -d "$src" ]; then
      log_debug "Skip copy $dir (not yet in main worktree)"
      continue
    fi

    local parent
    parent="$(dirname "$dst")"
    [ ! -d "$parent" ] && mkdir -p "$parent"

    copy_tree "$src" "$dst"
    log_info "Copied $dir"
    if [ "$project_type" = "elixir" ] && [ "$dir" = "_build" ]; then
      copied_elixir_build=true
    fi
  done <<EOF_COPY_DIRS
$copy_dirs
EOF_COPY_DIRS

  if [ "$copied_elixir_build" = true ]; then
    refresh_relocated_elixir_cache "$main_path" "$worktree_path"
    WERKSFEER_REUSED_ELIXIR_BUILD=1
  fi
}

# ---------------------------------------------------------------------------
# Database operations
# ---------------------------------------------------------------------------

has_psql() {
  command -v psql >/dev/null 2>&1
}

db_exists() {
  psql -lqt 2>/dev/null | awk '{print $1}' | grep -qxF "$1"
}

get_base_db_names() {
  local project_type="$1"
  local project_name
  project_name="$(sanitize_name "$(get_project_name)")"

  # Allow override from config
  local override
  override="$(toml_get "database" "base_name" "")"
  [ -n "$override" ] && project_name="$(sanitize_name "$override")"

  local dev_suffix test_suffix
  case "$project_type" in
    rails)
      dev_suffix="$(toml_get "database" "dev_suffix" "_development")"
      test_suffix="$(toml_get "database" "test_suffix" "_test")"
      ;;
    elixir)
      dev_suffix="$(toml_get "database" "dev_suffix" "_dev")"
      test_suffix="$(toml_get "database" "test_suffix" "_test")"
      ;;
    *)
      # No DB cloning for other project types by default
      return 1
      ;;
  esac

  echo "${project_name}${dev_suffix}" "${project_name}${test_suffix}"
}

clone_databases() {
  local project_type="$1"

  if ! has_psql; then
    log_warn "psql not found, skipping database cloning"
    return 0
  fi

  local db_names
  db_names="$(get_base_db_names "$project_type")" || {
    log_info "No database cloning needed for project type: $project_type"
    return 0
  }

  local base_dev base_test
  base_dev="$(echo "$db_names" | awk '{print $1}')"
  base_test="$(echo "$db_names" | awk '{print $2}')"

  local wt_name wt_branch
  wt_name="$(sanitize_name "$(get_worktree_name)")"
  wt_branch="$(sanitize_name "$(get_worktree_branch)")"

  NEW_DEV_DB="worktree_${wt_branch}_${wt_name}"
  NEW_TEST_DB="worktree_${wt_branch}_${wt_name}_test"

  # Clone dev database
  if db_exists "$NEW_DEV_DB"; then
    log_info "Database $NEW_DEV_DB already exists, skipping"
  elif ! db_exists "$base_dev"; then
    log_warn "Template database $base_dev not found, skipping dev DB clone"
  else
    log_info "Cloning $base_dev -> $NEW_DEV_DB"
    psql -q -c "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = '${base_dev}' AND pid <> pg_backend_pid();" 2>/dev/null || true
    if ! psql -q -c "CREATE DATABASE \"${NEW_DEV_DB}\" WITH TEMPLATE \"${base_dev}\";"; then
      log_error "Failed to clone $base_dev -> $NEW_DEV_DB"
    fi
  fi

  # Clone test database
  if db_exists "$NEW_TEST_DB"; then
    log_info "Database $NEW_TEST_DB already exists, skipping"
  elif ! db_exists "$base_test"; then
    log_warn "Template database $base_test not found, skipping test DB clone"
  else
    log_info "Cloning $base_test -> $NEW_TEST_DB"
    psql -q -c "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = '${base_test}' AND pid <> pg_backend_pid();" 2>/dev/null || true
    if ! psql -q -c "CREATE DATABASE \"${NEW_TEST_DB}\" WITH TEMPLATE \"${base_test}\";"; then
      log_error "Failed to clone $base_test -> $NEW_TEST_DB"
    fi
  fi

}

use_private_postgres_cluster() {
  service_enabled "postgres"
}

set_private_cluster_database_names() {
  local project_type="$1"
  local db_names

  db_names="$(get_base_db_names "$project_type")" || return 0
  NEW_DEV_DB="$(echo "$db_names" | awk '{print $1}')"
  NEW_TEST_DB="$(echo "$db_names" | awk '{print $2}')"
}

setup_databases() {
  local project_type="$1"
  local project_root="$2"

  if use_private_postgres_cluster; then
    set_private_cluster_database_names "$project_type"
    run_service_action "postgres" "template_hydrate" "$project_root" "$project_type"
    run_services_action "prepare" "$project_root"
    export WERKSFEER_SERVICES_READY=1
  else
    clone_databases "$project_type"
  fi
}

# ---------------------------------------------------------------------------
# Environment overrides (DB names, ports, Redis)
# ---------------------------------------------------------------------------

default_base_port() {
  case "$1" in
    rails)  echo 3000 ;;
    elixir) echo 4000 ;;
    python) echo 8000 ;;
    node)   echo 3000 ;;
    *)      echo 3000 ;;
  esac
}

default_redis_url() {
  case "$1" in
    rails) echo "redis://localhost:6379" ;;
    *)     echo "" ;;
  esac
}

format_env_assignments() {
  local prefix="$1"
  local assignments="$2"
  local key value

  while IFS='=' read -r key value; do
    [ -z "$key" ] && continue
    printf '%s%s="%s"\n' "$prefix" "$key" "$value"
  done <<EOF_ASSIGNMENTS
$assignments
EOF_ASSIGNMENTS
}

write_managed_env_block() {
  local envfile="$1"
  local contents="$2"
  local start_marker="# >>> werksfeer managed environment >>>"
  local end_marker="# <<< werksfeer managed environment <<<"
  local tmp="${envfile}.werksfeer.$$"

  (umask 077 && : > "$tmp")

  if [ -f "$envfile" ]; then
    awk -v start="$start_marker" -v finish="$end_marker" '
      $0 == start { managed = 1; next }
      $0 == finish { managed = 0; next }
      !managed { print }
    ' "$envfile" > "$tmp"

    local mode
    if mode="$(stat -f '%Lp' "$envfile" 2>/dev/null)"; then
      chmod "$mode" "$tmp"
    elif mode="$(stat -c '%a' "$envfile" 2>/dev/null)"; then
      chmod "$mode" "$tmp"
    fi
  fi

  {
    printf '\n%s\n' "$start_marker"
    printf '%s\n' "$contents"
    printf '%s\n' "$end_marker"
  } >> "$tmp"

  mv "$tmp" "$envfile"
  log_info "Wrote managed environment to $envfile"
}

managed_shell_environment() {
  local assignments="$1"

  format_env_assignments "export " "$assignments"

  if [ -n "$(service_names)" ]; then
    cat <<'EOF_SERVICE_START'

# Keep worktree services available when a new interactive shell enters here.
if [ "${WERKSFEER_SERVICES_READY:-0}" != "1" ] && command -v werksfeer >/dev/null 2>&1; then
  werksfeer services start
  export WERKSFEER_SERVICES_READY=1
fi
EOF_SERVICE_START
  fi
}

allow_project_environment() {
  if command -v direnv >/dev/null 2>&1 && [ -f ".envrc" ]; then
    direnv allow . 2>/dev/null || true
  fi
}

write_env_overrides() {
  local project_type="$1"
  local worktree_root="$2"
  local wt_name project_root existing base_redis
  wt_name="$(get_worktree_name)"
  project_root="$(get_main_worktree_path)"
  existing="$(lookup_allocation "$project_root" "$wt_name")"
  base_redis="$(toml_get "redis" "url" "$(default_redis_url "$project_type")")"

  local wt_port redis_db redis_port=""
  if [ -n "$existing" ]; then
    wt_port="$(echo "$existing" | cut -f1)"
    redis_db="$(echo "$existing" | cut -f2)"
    redis_port="$(echo "$existing" | cut -f3)"
    log_debug "Reusing allocation: port=$wt_port redis_db=$redis_db redis_port=$redis_port"
  else
    local base_port
    base_port="$(toml_get "port" "base" "$(default_base_port "$project_type")")"
    wt_port="$(allocate_port "$base_port")"
    redis_db="$(allocate_redis_db "$project_root")"
  fi

  if [ -n "$base_redis" ] && [ -z "$redis_port" ]; then
    local base_redis_port
    base_redis_port="$(echo "$base_redis" | grep -oE ':[0-9]+' | tail -1 | tr -d ':')"
    base_redis_port="${base_redis_port:-6379}"
    redis_port="$(allocate_redis_port "$base_redis_port")"
  fi

  if [ -z "$existing" ]; then
    register_allocation "$project_root" "$wt_name" "$wt_port" "$redis_db" "$redis_port"
  fi

  local wt_redis=""
  if [ -n "$base_redis" ]; then
    local base_stripped
    base_stripped="$(echo "$base_redis" | sed 's|/[0-9]*$||')"
    if [ -n "$redis_port" ]; then
      wt_redis="$(echo "$base_stripped" | sed "s|:[0-9]*$|:${redis_port}|")/${redis_db}"
    else
      wt_redis="${base_stripped}/${redis_db}"
    fi
  fi

  local dev_db="${NEW_DEV_DB:-}"
  local test_db="${NEW_TEST_DB:-}"
  local service_env
  service_env="$(services_environment "$worktree_root")"

  local common_assignments="PORT=${wt_port}"
  [ -n "$wt_redis" ] && common_assignments="${common_assignments}
REDIS_URL=${wt_redis}"
  [ -n "$redis_port" ] && common_assignments="${common_assignments}
REDIS_PORT=${redis_port}"
  [ -n "$dev_db" ] && common_assignments="${common_assignments}
DATABASE_NAME=${dev_db}"
  [ -n "$test_db" ] && common_assignments="${common_assignments}
TEST_DATABASE_NAME=${test_db}"
  [ -n "$service_env" ] && common_assignments="${common_assignments}
${service_env}"

  case "$project_type" in
    rails)
      write_managed_env_block ".env.local" "$(format_env_assignments "" "$common_assignments")"

      local test_assignments=""
      [ -n "$test_db" ] && test_assignments="TEST_DATABASE_NAME=${test_db}"
      [ -n "$service_env" ] && test_assignments="${test_assignments}
${service_env}"
      write_managed_env_block ".env.test.local" "$(format_env_assignments "" "$test_assignments")"
      ;;
    python|node)
      write_managed_env_block ".env" "$(format_env_assignments "" "$common_assignments")"
      ;;
  esac

  # Every framework gets the same shell contract. Framework-specific dotenv
  # files above remain available for processes that load them themselves.
  write_managed_env_block ".envrc" "$(managed_shell_environment "$common_assignments")"
  allow_project_environment

  log_info "Port: ${wt_port}"
  if [ -n "$wt_redis" ]; then
    log_info "Redis: ${wt_redis}"
  fi
}

# ---------------------------------------------------------------------------
# Setup commands
# ---------------------------------------------------------------------------

detect_node_pm() {
  local root="$1"
  if [ -f "$root/bun.lockb" ] || [ -f "$root/bun.lock" ]; then echo "bun install --frozen-lockfile"
  elif [ -f "$root/pnpm-lock.yaml" ]; then echo "pnpm install --frozen-lockfile"
  elif [ -f "$root/yarn.lock" ]; then echo "yarn install --frozen-lockfile"
  elif [ -f "$root/package-lock.json" ] || [ -f "$root/npm-shrinkwrap.json" ]; then echo "npm ci"
  else echo "npm install"
  fi
}

project_mise_bin() {
  local project_root
  project_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

  if [ ! -f "$project_root/.tool-versions" ] &&
      [ ! -f "$project_root/mise.toml" ] &&
      [ ! -f "$project_root/.mise.toml" ] &&
      [ ! -f "$project_root/mise.local.toml" ] &&
      [ ! -f "$project_root/.mise.local.toml" ]; then
    return 1
  fi

  command -v mise 2>/dev/null
}

project_asdf_bin() {
  local project_root
  project_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

  [ -f "$project_root/.tool-versions" ] || return 1
  command -v asdf 2>/dev/null
}

run_with_mise() {
  local mise_bin="$1"
  shift
  local bin_path=""
  local bin_paths=""

  while IFS= read -r bin_path; do
    [ -z "$bin_path" ] && continue
    if [ -n "$bin_paths" ]; then
      bin_paths="${bin_paths}:${bin_path}"
    else
      bin_paths="$bin_path"
    fi
  done <<< "$("$mise_bin" bin-paths)"

  if [ -n "$bin_paths" ]; then
    # Some GUI harnesses prepend system paths after shell activation. Keep the
    # repository-pinned binaries first even in that inherited environment.
    "$mise_bin" exec -- env PATH="${bin_paths}:${PATH}" "$@"
  else
    "$mise_bin" exec -- "$@"
  fi
}

run_with_asdf() {
  local asdf_bin="$1"
  shift
  local asdf_data_dir="${ASDF_DATA_DIR:-$HOME/.asdf}"
  local shims_dir="${asdf_data_dir}/shims"

  if [ -d "$shims_dir" ]; then
    # asdf selects the .tool-versions entry through its shims. Put them first
    # for GUI harnesses whose inherited PATH puts system tools ahead of asdf.
    env PATH="${shims_dir}:${PATH}" "$@"
  else
    "$asdf_bin" exec "$@"
  fi
}

run_in_project_environment() {
  local mise_bin=""
  local asdf_bin=""
  mise_bin="$(project_mise_bin)" || true
  if [ -z "$mise_bin" ]; then
    asdf_bin="$(project_asdf_bin)" || true
  fi

  if command -v direnv >/dev/null 2>&1 && [ -f ".envrc" ]; then
    if [ -n "$mise_bin" ]; then
      direnv exec . "${WERKSFEER_SCRIPT_DIR}/werksfeer" --mise-exec "$mise_bin" "$@"
    elif [ -n "$asdf_bin" ]; then
      direnv exec . "${WERKSFEER_SCRIPT_DIR}/werksfeer" --asdf-exec "$asdf_bin" "$@"
    else
      direnv exec . "$@"
    fi
  elif [ -n "$mise_bin" ]; then
    run_with_mise "$mise_bin" "$@"
  elif [ -n "$asdf_bin" ]; then
    run_with_asdf "$asdf_bin" "$@"
  else
    "$@"
  fi
}

run_shell_in_project_environment() {
  run_in_project_environment /bin/bash -c "$1"
}

install_node_dependencies() {
  [ -f "package.json" ] || return 0

  if [ "${WERKSFEER_REUSED_NODE_DEPENDENCIES:-0}" = "1" ]; then
    log_info "Reused node_modules is ready, skipping package installation"
    return 0
  fi

  if [ -L "node_modules" ]; then
    log_info "Shared node_modules is already linked, skipping package installation"
    return 0
  fi

  local pm_cmd
  pm_cmd="$(toml_get "setup" "node_install" "")"
  [ -z "$pm_cmd" ] && pm_cmd="$(detect_node_pm "$(pwd)")"
  log_step "Running $pm_cmd"
  run_shell_in_project_environment "$pm_cmd"
}

run_post_dependencies_hook() {
  local hook
  hook="$(toml_get "hooks" "post_dependencies" "")"
  [ -z "$hook" ] && return 0

  log_step "Running post-dependencies hook"
  run_shell_in_project_environment "$hook"
}

run_dependency_setup() {
  local project_type="$1"

  case "$project_type" in
    rails)
      log_step "Running bundle install"
      run_in_project_environment bundle install
      install_node_dependencies
      ;;
    elixir)
      if [ "${WERKSFEER_REUSED_ELIXIR_BUILD:-0}" = "1" ] &&
          run_in_project_environment mix deps.loadpaths --no-compile >/dev/null 2>&1 &&
          run_in_project_environment env MIX_ENV=test mix deps.loadpaths --no-compile >/dev/null 2>&1; then
        log_info "Reused Elixir dependencies are ready, skipping mix deps.get"
      else
        log_step "Running mix deps.get"
        run_in_project_environment mix deps.get
        log_step "Running mix deps.get for test"
        run_in_project_environment env MIX_ENV=test mix deps.get
      fi
      log_step "Running mix compile"
      run_in_project_environment mix compile
      install_node_dependencies
      ;;
    python)
      if [ -f "pyproject.toml" ] && command -v uv >/dev/null 2>&1; then
        log_step "Running uv sync"
        run_in_project_environment uv sync
      elif [ -f "Pipfile" ] && command -v pipenv >/dev/null 2>&1; then
        log_step "Running pipenv install"
        run_in_project_environment pipenv install
      elif [ -f "requirements.txt" ]; then
        log_step "Running pip install -r requirements.txt"
        run_in_project_environment pip install -r requirements.txt
      fi
      ;;
    node)
      install_node_dependencies
      ;;
    *)
      log_info "Unknown project type, no dependency setup to run"
      ;;
  esac
}

run_database_setup() {
  local project_type="$1"
  local worktree_root="$2"

  case "$project_type" in
    rails)
      if [ -x "bin/rails" ]; then
        log_step "Running bin/rails db:prepare"
        run_in_project_environment bin/rails db:prepare
        log_step "Running bin/rails db:prepare for test"
        run_in_project_environment env RAILS_ENV=test bin/rails db:prepare
      fi
      ;;
    elixir)

      # Private clusters start empty and migrations remain application-owned.
      # Shared clones already contain the source database's schema and data.
      if use_private_postgres_cluster; then
        if postgres_setting_enabled "$worktree_root" &&
            run_service_action "postgres" "database_exists" "$worktree_root" "$NEW_DEV_DB"; then
          log_step "Migrating the private development database"
          run_in_project_environment mix ecto.migrate
        elif postgres_setting_enabled "$worktree_root"; then
          log_step "Creating, migrating, and seeding the private development database"
          run_in_project_environment mix ecto.setup
        else
          log_step "Creating and migrating the configured development database"
          run_in_project_environment mix ecto.create --quiet
          run_in_project_environment mix ecto.migrate
        fi

        log_step "Creating and migrating the private test database"
        run_in_project_environment env MIX_ENV=test mix ecto.create --quiet
        run_in_project_environment env MIX_ENV=test mix ecto.migrate --quiet
      elif [ -z "${NEW_DEV_DB:-}" ]; then
        log_step "Running mix ecto.setup"
        run_in_project_environment mix ecto.setup
      else
        log_info "Databases already cloned, skipping mix ecto.setup"
      fi
      ;;
  esac
}

run_setup_command() {
  local project_type="$1"
  local worktree_root="$2"

  # A custom command retains its historical full-override behavior.
  local custom_cmd
  custom_cmd="$(toml_get "setup" "command" "")"

  if [ -n "$custom_cmd" ]; then
    log_step "Running custom setup: $custom_cmd"
    run_shell_in_project_environment "$custom_cmd"
    return
  fi

  run_dependency_setup "$project_type"
  run_post_dependencies_hook
  run_database_setup "$project_type" "$worktree_root"
}

# ---------------------------------------------------------------------------
# Project registry (for --prune-all)
# ---------------------------------------------------------------------------

registry_file() {
  echo "${XDG_DATA_HOME:-$HOME/.local/share}/werksfeer/projects"
}

register_project() {
  local reg
  reg="$(registry_file)"
  local project_root
  project_root="$(get_main_worktree_path)"

  mkdir -p "$(dirname "$reg")"
  if ! grep -qxF "$project_root" "$reg" 2>/dev/null; then
    echo "$project_root" >> "$reg"
  fi
}

# ---------------------------------------------------------------------------
# Cleanup (drop databases for a specific worktree)
# ---------------------------------------------------------------------------

cleanup_worktree() {
  local worktree_path="$1"
  local wt_name
  wt_name="$(basename "$worktree_path")"

  log_step "Cleaning up worktree: $wt_name"

  local project_root=""
  local main_path=""
  local private_postgres=false
  if [ -d "$worktree_path" ] && (cd "$worktree_path" && is_git_repo); then
    project_root="$(cd "$worktree_path" && current_project_root)"
    main_path="$(cd "$project_root" && get_main_worktree_path)"

    if load_project_configuration "$project_root"; then
      if use_private_postgres_cluster; then
        private_postgres=true
      fi
      run_services_action "cleanup" "$project_root"
    fi
  fi

  # Deregister port/redis allocation
  deregister_allocation "$wt_name" "$main_path"
  log_info "Released port/redis allocation"

  if [ "$private_postgres" = true ]; then
    return 0
  fi

  if ! has_psql; then
    log_warn "psql not found, skipping database cleanup"
    return 0
  fi

  wt_name="$(sanitize_name "$wt_name")"

  # Try to get the branch from the worktree if it still exists
  local wt_branch=""
  if [ -d "$worktree_path" ]; then
    wt_branch="$(cd "$worktree_path" 2>/dev/null && sanitize_name "$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo HEAD)")"
  fi

  if [ -n "$wt_branch" ]; then
    # We know the exact DB names
    local dev_db="worktree_${wt_branch}_${wt_name}"
    local test_db="worktree_${wt_branch}_${wt_name}_test"
    for db in "$dev_db" "$test_db"; do
      if db_exists "$db"; then
        log_info "Dropping $db"
        dropdb --if-exists "$db" 2>/dev/null || log_warn "Failed to drop $db"
      fi
    done
  else
    # Worktree already deleted — find DBs by suffix match on the worktree name
    log_debug "Worktree directory gone, scanning for databases ending with _${wt_name}"
    local all_wt_dbs
    all_wt_dbs="$(psql -lqt 2>/dev/null | awk '{print $1}' | grep '^worktree_' || true)"
    echo "$all_wt_dbs" | while IFS= read -r db; do
      [ -z "$db" ] && continue
      # Match: worktree_{anything}_{wt_name} or worktree_{anything}_{wt_name}_test
      if echo "$db" | grep -qE "_${wt_name}(_test)?$"; then
        log_info "Dropping $db"
        dropdb --if-exists "$db" 2>/dev/null || log_warn "Failed to drop $db"
      fi
    done
  fi
}

# ---------------------------------------------------------------------------
# Prune
# ---------------------------------------------------------------------------

prune_project() {
  local project_dir="${1:-.}"

  if ! (cd "$project_dir" && is_git_repo); then
    log_warn "$project_dir is not a git repo, skipping"
    return 0
  fi

  # Prune stale allocations: remove entries for worktrees that no longer exist
  local alloc
  alloc="$(allocations_file)"
  if [ -f "$alloc" ]; then
    local active_wt_names=""
    while IFS= read -r wt_line; do
      local wt_path
      wt_path="$(echo "$wt_line" | awk '{print $1}')"
      active_wt_names="${active_wt_names}$(basename "$wt_path")
"
    done < <(cd "$project_dir" && git worktree list 2>/dev/null)

    local tmp="${alloc}.tmp"
    while IFS="$(printf '\t')" read -r a_project a_wt a_port a_redis; do
      if [ "$a_project" = "$project_dir" ] && ! echo "$active_wt_names" | grep -qxF "$a_wt"; then
        log_info "Released allocation: port=$a_port redis_db=$a_redis (worktree: $a_wt)"
      else
        printf '%s\t%s\t%s\t%s\n' "$a_project" "$a_wt" "$a_port" "$a_redis"
      fi
    done < "$alloc" > "$tmp"
    mv "$tmp" "$alloc"
  fi

  if ! has_psql; then
    log_warn "psql not found, skipping database prune"
    return 0
  fi

  # Get all worktree_* databases
  local all_wt_dbs
  all_wt_dbs="$(psql -lqt 2>/dev/null | awk '{print $1}' | grep '^worktree_' || true)"

  if [ -z "$all_wt_dbs" ]; then
    log_info "No worktree databases found"
    return 0
  fi

  # Build exact list of expected DB names for all active worktrees.
  # Each worktree produces two DBs: worktree_{branch}_{name} (dev)
  # and worktree_{branch}_{name}_test (test).
  # We cannot strip _test to infer stems because the worktree name
  # itself may end with _test (e.g. wt-ragout-test).
  local active_dbs=""
  while IFS= read -r wt_line; do
    local wt_path wt_basename wt_branch
    wt_path="$(echo "$wt_line" | awk '{print $1}')"
    wt_basename="$(sanitize_name "$(basename "$wt_path")")"
    wt_branch="$(cd "$wt_path" 2>/dev/null && sanitize_name "$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo HEAD)")"
    active_dbs="${active_dbs}worktree_${wt_branch}_${wt_basename}
worktree_${wt_branch}_${wt_basename}_test
"
  done < <(cd "$project_dir" && git worktree list 2>/dev/null)

  echo "$all_wt_dbs" | while IFS= read -r db; do
    [ -z "$db" ] && continue

    local found=false
    while IFS= read -r active_db; do
      [ -z "$active_db" ] && continue
      if [ "$db" = "$active_db" ]; then
        found=true
        break
      fi
    done <<EOF
$active_dbs
EOF

    if [ "$found" = false ]; then
      log_info "Dropping orphaned database: $db"
      dropdb --if-exists "$db" 2>/dev/null || log_warn "Failed to drop $db"
    else
      log_debug "Keeping active database: $db"
    fi
  done
}

prune_current() {
  if ! is_git_repo; then
    log_error "Not in a git repository"
    return 1
  fi
  local main_path
  main_path="$(get_main_worktree_path)"
  log_step "Pruning orphaned databases for: $(basename "$main_path")"
  prune_project "$main_path"
}

prune_all() {
  local reg
  reg="$(registry_file)"

  if [ ! -f "$reg" ]; then
    log_warn "No projects registered yet. Run werksfeer in a project first."
    return 0
  fi

  while IFS= read -r project_path; do
    [ -z "$project_path" ] && continue
    if [ ! -d "$project_path" ]; then
      log_warn "Skipping $project_path (directory not found)"
      continue
    fi
    log_step "Pruning databases for: $(basename "$project_path")"
    prune_project "$project_path"
  done < "$reg"
}

# ---------------------------------------------------------------------------
# Core setup flow
# ---------------------------------------------------------------------------

run_setup() {
  local main_path
  main_path="$(get_main_worktree_path)"
  local worktree_path
  worktree_path="$(pwd)"

  log_step "werksfeer v${WERKSFEER_VERSION} - Setting up worktree"
  log_info "Main:     $main_path"
  log_info "Worktree: $worktree_path"

  load_project_configuration "$worktree_path"

  # Detect project type
  local project_type
  project_type="$(detect_project_type "$main_path")"
  log_info "Project type: $project_type"

  if managed_cache_auto_warm_enabled; then
    if ! managed_cache_warm "$worktree_path"; then
      log_warn "Managed build cache warming failed; continuing with available local caches"
    fi
  else
    local auto_warm_status=$?
    [ "$auto_warm_status" -eq 1 ] || return "$auto_warm_status"
  fi

  local build_cache_source="$main_path"
  local managed_source=""
  managed_source="$(managed_cache_source "$main_path" "$worktree_path")" || managed_source=""
  if [ -n "$managed_source" ]; then
    build_cache_source="$managed_source"
    log_info "Using managed build cache: $managed_source"
  fi

  # Register for prune-all
  register_project

  # Step 1: Copy env files
  log_step "Copying environment files"
  sync_env_files "$main_path" "$worktree_path" "$project_type"
  # Harnesses may still launch an agent to diagnose a later setup failure.
  # Approve a copied .envrc now, then approve its managed rewrite below too.
  allow_project_environment

  # Step 2: Restore shared directories (node_modules). Managed caches are
  # copied so a feature worktree can never mutate the authoritative cache.
  log_step "Restoring shared directories"
  if [ -n "$managed_source" ]; then
    sync_managed_shared_dirs "$build_cache_source" "$worktree_path" "$project_type"
  else
    sync_symlink_dirs "$main_path" "$worktree_path" "$project_type"
  fi

  # Step 3: Copy build directories
  log_step "Copying build directories"
  copy_build_dirs "$build_cache_source" "$worktree_path" "$project_type"

  # Step 4: Provision databases/services
  log_step "Setting up databases"
  setup_databases "$project_type" "$worktree_path"

  # Step 5: Write environment overrides (DB names, ports, Redis)
  log_step "Writing environment overrides"
  write_env_overrides "$project_type" "$worktree_path"

  # Step 6: Run setup command
  log_step "Running setup"
  run_setup_command "$project_type" "$worktree_path"

  # Publish only a cleanly stopped, fully prepared database whose HEAD exactly
  # matches the configured remote template ref. Feature-branch state is never
  # shared with unrelated worktrees.
  if use_private_postgres_cluster; then
    if ! run_service_action "postgres" "template_publish" "$worktree_path" "$project_type"; then
      log_warn "PostgreSQL template publication failed; the worktree database remains usable"
    fi
  fi

  # Step 7: Post-setup hook from config
  local post_hook
  post_hook="$(toml_get "hooks" "post_setup" "")"
  if [ -n "$post_hook" ]; then
    log_step "Running post-setup hook"
    run_shell_in_project_environment "$post_hook"
  fi

  log_step "Worktree setup complete!"
}

# ---------------------------------------------------------------------------
# Usage
# ---------------------------------------------------------------------------

usage() {
  cat >&2 <<'EOF_USAGE'
werksfeer - Universal git worktree setup

Usage:
  werksfeer                  Setup the current worktree (run from inside a worktree)
  werksfeer --hook ...       Called from post-checkout git hook
  werksfeer services COMMAND Manage configured worktree services
  werksfeer postgres COMMAND Manage the PostgreSQL service directly
  werksfeer exec COMMAND...  Run a command through the worktree's project environment
  werksfeer cache warm      Refresh the managed dependency/build cache
  werksfeer cache status    Inspect the managed dependency/build cache
  werksfeer --cleanup [PATH] Stop services and clean a worktree (defaults to current directory)
  werksfeer --prune          Drop orphaned worktree databases for current project
  werksfeer --prune-all      Drop orphaned worktree databases for all registered projects
  werksfeer --version        Print version
  werksfeer --help           Print this help

Environment:
  WERKSFEER_DEBUG=1         Enable debug logging
  WERKSFEER_POSTGRES=false Disable private PostgreSQL for this shell
  WERKSFEER_CACHE_AUTO_WARM=true|false Override automatic cache warming
  WERKSFEER_LIB_DIR=PATH    Override the service module directory

Werksfeer reads .worktree.toml, then overlays ignored .worktree.local.toml
files from the main checkout and current worktree when present.
See https://github.com/DefactoSoftware/werksfeer for details.
EOF_USAGE
}

# ---------------------------------------------------------------------------
# Entry points
# ---------------------------------------------------------------------------

hook_mode() {
  local prev_head="${1:-}"
  local new_head="${2:-}"
  local flag="${3:-}"

  if ! is_worktree_creation "$prev_head" "$new_head" "$flag"; then
    log_debug "Not a worktree creation, skipping"
    return 0
  fi

  # Only activate when .worktree.toml exists
  local main_path
  main_path="$(get_main_worktree_path)"
  if [ ! -f "$main_path/.worktree.toml" ] && [ ! -f ".worktree.toml" ]; then
    log_debug "No .worktree.toml found, skipping"
    return 0
  fi

  run_setup
}

direct_mode() {
  if ! is_git_repo; then
    log_error "Not inside a git repository"
    return 1
  fi

  if ! is_worktree; then
    log_error "Not inside a worktree (this is the main checkout)"
    log_info "Run this from inside a worktree created with: wt switch -c <branch>"
    return 1
  fi

  local main_path
  main_path="$(get_main_worktree_path)"
  if [ ! -f "$main_path/.worktree.toml" ] && [ ! -f ".worktree.toml" ]; then
    log_error "No .worktree.toml found in $main_path"
    log_info "Create one to configure werksfeer. See: werksfeer --help"
    return 1
  fi

  run_setup
}

service_mode() {
  local command="$1"
  shift
  local action="${1:-}"
  [ "$#" -gt 0 ] && shift

  if ! is_git_repo; then
    log_error "Not inside a git repository"
    return 1
  fi

  local project_root
  project_root="$(current_project_root)"
  load_project_configuration "$project_root"

  if [ "$command" = "services" ]; then
    services_cli "$action" "$project_root"
  else
    service_provider_cli "$command" "$action" "$project_root" "$@"
  fi
}

exec_mode() {
  shift
  if [ "$#" -eq 0 ]; then
    log_error "exec requires a command"
    return 1
  fi

  if ! is_git_repo; then
    log_error "Not inside a git repository"
    return 1
  fi

  local project_root
  project_root="$(current_project_root)"
  load_project_configuration "$project_root"
  run_services_action "start" "$project_root"
  export WERKSFEER_SERVICES_READY=1

  run_in_project_environment "$@"
}

cache_mode() {
  shift
  local action="${1:-status}"

  if ! is_git_repo; then
    log_error "Not inside a git repository"
    return 1
  fi

  local project_root
  project_root="$(current_project_root)"
  load_project_configuration "$project_root"

  case "$action" in
    warm) managed_cache_warm "$project_root" ;;
    status) managed_cache_status "$project_root" ;;
    *)
      log_error "Unknown cache command: $action"
      log_info "Available commands: warm, status"
      return 2
      ;;
  esac
}

main() {
  case "${1:-}" in
    --mise-exec)
      shift
      run_with_mise "$@"
      ;;
    --asdf-exec)
      shift
      run_with_asdf "$@"
      ;;
    --hook)
      shift
      hook_mode "$@"
      ;;
    --cleanup)
      shift
      cleanup_worktree "${1:-$(pwd)}"
      ;;
    --prune)
      prune_current
      ;;
    --prune-all)
      prune_all
      ;;
    services)
      service_mode "$@"
      ;;
    postgres)
      service_mode "$@"
      ;;
    exec)
      exec_mode "$@"
      ;;
    cache)
      cache_mode "$@"
      ;;
    --version|-V)
      echo "werksfeer $WERKSFEER_VERSION"
      ;;
    --help|-h)
      usage
      ;;
    *)
      direct_mode
      ;;
  esac
}

load_werksfeer_modules
main "$@"
