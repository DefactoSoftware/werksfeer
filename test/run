#!/usr/bin/env bash

set -euo pipefail

script_directory="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
bats "${script_directory}/cli.bats"

if command -v initdb >/dev/null 2>&1; then
  "${script_directory}/postgres-scenarios"
else
  echo "initdb not found, skipping PostgreSQL scenarios" >&2
fi
