# werksfeer configuration
# Copy this file to .worktree.toml in your project root and adjust as needed.
# All sections and keys are optional — werksfeer auto-detects sensible defaults.

[database]
# Override the base database name (default: lowercase project directory name)
# base_name = "myapp"

# Override suffixes (Rails default: _development/_test, Elixir default: _dev/_test)
# dev_suffix = "_development"
# test_suffix = "_test"

[port]
# Base port for the web server (default: 3000 for Rails/Node, 4000 for Elixir, 8000 for Python)
# Each worktree gets the next available port starting from base+1.
# Allocations are tracked in ~/.local/share/werksfeer/allocations and
# released on --cleanup or --prune.
# base = 3000

[redis]
# Base Redis URL (default: redis://localhost:6379 for Rails, empty for others)
# Each worktree gets the next available Redis database number (1-15).
# url = "redis://localhost:6379"

[sync]
# Directories to symlink from the main worktree (default: node_modules)
# symlink = ["node_modules"]

# Directories to copy from the main worktree (default: build dirs per project type)
# copy_dirs = ["_build", "deps"]

# Files to copy from the main worktree (overrides auto-detected defaults)
# copy = [".env", ".envrc", ".tool-versions"]

# Directories to never sync
# skip = ["tmp"]

[setup]
# Override the auto-detected setup command
# command = "bin/setup"

[hooks]
# Shell command to run after worktree setup is complete
# post_setup = "echo 'ready!'"
